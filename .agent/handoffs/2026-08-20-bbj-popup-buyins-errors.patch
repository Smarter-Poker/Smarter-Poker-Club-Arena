+  justify-content: space-between;
+  padding: 8px 10px;
+  border-radius: 8px;
+  background: rgba(255, 215, 0, 0.07);
+  border: 1px solid rgba(255, 215, 0, 0.2);
+  font-size: 12px;
+  font-weight: 700;
+  color: #ffd700;
+  font-variant-numeric: tabular-nums;
