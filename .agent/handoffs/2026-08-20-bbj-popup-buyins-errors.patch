+  overflow: hidden;
+}
+
+.bbjhd__sd {
+  padding: 8px;
+  background: rgba(255, 255, 255, 0.02);
+}
+
+.bbjhd__sd + .bbjhd__sd {
+  border-top: 1px solid rgba(255, 255, 255, 0.05);
+}
+
+.bbjhd__sd-top {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  margin-bottom: 6px;
+  font-size: 11.5px;
+}
+
+.bbjhd__sd-hand {
+  flex: 1;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
