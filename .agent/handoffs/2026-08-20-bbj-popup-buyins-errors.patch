+  color: rgba(255, 255, 255, 0.5);
+  font-size: 10.5px;
+}
+
+.bbjhd__sd-net {
+  flex-shrink: 0;
+  font-weight: 800;
+  font-variant-numeric: tabular-nums;
+}
+
+.bbjhd__sd-net.is-up {
