+  background: rgba(255, 215, 0, 0.07);
+}
+
+.bbjhd__pay--bad_beat .bbjhd__pay-amt {
+  color: #ffd700;
+}
+
+.bbjhd__empty {
+  padding: 28px 16px;
+  text-align: center;
+  font-size: 12.5px;
+  color: rgba(255, 255, 255, 0.5);
+}
+
+.bbjhd__skeletons {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+}
+
+.bbjhd__skeleton {
