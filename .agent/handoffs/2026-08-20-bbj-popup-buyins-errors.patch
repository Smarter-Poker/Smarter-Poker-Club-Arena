+/* BBJ hand detail — street-by-street rundown of a jackpot hand.
+   Built 375px-first: five columns that stay legible on the narrowest phone. */
+
+.bbjhd {
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+  color: #fff;
+}
+
+.bbjhd__head {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.bbjhd__back {
+  width: 36px;
+  height: 36px;
+  flex-shrink: 0;
+  border-radius: 10px;
+  border: 1px solid rgba(255, 255, 255, 0.14);
+  background: rgba(255, 255, 255, 0.05);
+  color: rgba(255, 255, 255, 0.85);
+  font-size: 22px;
+  line-height: 1;
+  cursor: pointer;
+}
+
+.bbjhd__title {
+  font-size: 13px;
+  font-weight: 800;
+  letter-spacing: 1.2px;
+  color: rgba(255, 228, 181, 0.9);
+}
+
+.bbjhd__meta {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  flex-wrap: wrap;
+  padding: 8px 10px;
+  border-radius: 8px;
+  background: rgba(255, 255, 255, 0.04);
+  font-size: 11px;
+  color: rgba(255, 255, 255, 0.7);
+  font-variant-numeric: tabular-nums;
+}
+
+.bbjhd__meta-stakes {
+  color: #ffd700;
+  font-weight: 700;
+}
+
+.bbjhd__meta-sn {
+  color: rgba(255, 255, 255, 0.4);
+}
+
+.bbjhd__colkey {
+  display: grid;
+  grid-template-columns: 1fr auto auto;
+  gap: 8px;
+  padding: 0 10px;
+  font-size: 9px;
+  letter-spacing: 0.6px;
+  text-transform: uppercase;
+  color: rgba(255, 255, 255, 0.32);
+}
+
+.bbjhd__colkey span:nth-child(2) {
+  justify-self: center;
+}
+
+.bbjhd__streets {
+  display: flex;
+  flex-direction: column;
+  gap: 8px;
+}
+
+.bbjhd__street {
+  border-radius: 10px;
+  border: 1px solid rgba(255, 255, 255, 0.07);
+  overflow: hidden;
+}
+
+.bbjhd__street-head {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  padding: 7px 10px;
+  background: rgba(255, 255, 255, 0.06);
+  font-size: 12px;
+  font-weight: 700;
+  color: rgba(255, 255, 255, 0.85);
+}
+
+.bbjhd__street-name {
+  flex-shrink: 0;
+}
+
+.bbjhd__street-board {
+  display: flex;
+  gap: 3px;
+  flex: 1;
+  min-width: 0;
+  overflow: hidden;
+}
+
+.bbjhd__street-pot {
+  margin-left: auto;
+  flex-shrink: 0;
+  color: #ffd700;
+  font-variant-numeric: tabular-nums;
+}
+
+/* Action row: position | name | action chip | amount | running pot */
+.bbjhd__row {
+  display: grid;
+  grid-template-columns: 34px minmax(0, 1fr) auto 52px 58px;
+  align-items: center;
+  gap: 6px;
+  padding: 5px 8px;
+  font-size: 11.5px;
+  background: rgba(255, 255, 255, 0.02);
+}
+
+.bbjhd__row + .bbjhd__row {
+  border-top: 1px solid rgba(255, 255, 255, 0.045);
+}
+
+.bbjhd__pos {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  min-width: 30px;
+  height: 17px;
+  padding: 0 4px;
+  border-radius: 4px;
+  background: rgba(255, 176, 32, 0.16);
+  color: #ffb020;
+  font-size: 9px;
+  font-weight: 800;
+  letter-spacing: 0.3px;
+}
+
+.bbjhd__pos:empty {
+  background: transparent;
+}
+
+.bbjhd__name {
