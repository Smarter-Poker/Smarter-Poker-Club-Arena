+name: Currency meter reads what is owed
+
+# fn_ca_currency_meter() and the ca-ledger-replay-nightly split (migration
+# 20261015034439). Runs scripts/ci/test-currency-meter-reads-what-is-owed.py
+# against a throwaway PostgreSQL 17 cluster, never production: the exact
+# production meter and job 286 command captured 2026-10-15 (md5 equal to the
+# live ones), randomized books proving the new per-range commission read
+# equals the agent_commissions_unsettled view per (club, agent), the meter's
+# verdict unchanged, the derived postimage md5, the split cron jobs, and a
+# refused second run. No timer (CLAUDE.md 10.85): pull_request only, scoped
+# to the paths it proves.
+on:
+  pull_request:
+    branches: [main]
+    paths:
+      - supabase/migrations/20261015034439_the_currency_meter_reads_what_is_owed_and_runs_on_its_own.sql
+      - supabase/migrations/20261012181905_scoped_club_launch_reset_and_guarded_recovery.sql
+      - scripts/ci/fixtures/currency-meter-reads-what-is-owed/**
+      - scripts/ci/test-currency-meter-reads-what-is-owed.py
+      - .github/workflows/currency-meter-reads-what-is-owed.yml
+
+permissions:
+  contents: read
+
+concurrency:
+  group: currency-meter-reads-what-is-owed-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  currency-meter-reads-what-is-owed:
+    name: Currency meter reads what is owed and runs on its own
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@v4
+      - name: Install PostgreSQL 17 from the signed PGDG source only
+        run: |
+          set -euo pipefail
+          pg_sources="$(mktemp -d "$RUNNER_TEMP/ca-postgres-apt.XXXXXX")"
+          chmod 755 "$pg_sources"
+          test -f /etc/apt/sources.list.d/ubuntu.sources
+          cp /etc/apt/sources.list.d/ubuntu.sources "$pg_sources/ubuntu.sources"
+          pg_apt=(-o "Dir::Etc::sourcelist=/dev/null" -o "Dir::Etc::sourceparts=$pg_sources")
+          sudo apt-get "${pg_apt[@]}" update
+          sudo apt-get "${pg_apt[@]}" install -y --no-install-recommends postgresql-common curl ca-certificates
+          sudo install -d /usr/share/postgresql-common/pgdg
+          sudo curl --fail --silent --show-error --location \
+            --output /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
+            https://www.postgresql.org/media/keys/ACCC4CF8.asc
+          codename="$(. /etc/os-release && printf '%s' "$VERSION_CODENAME")"
+          printf 'Types: deb\nURIs: https://apt.postgresql.org/pub/repos/apt\nSuites: %s-pgdg\nComponents: main\nSigned-By: /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc\n' \
+            "$codename" > "$pg_sources/pgdg.sources"
+          sudo apt-get "${pg_apt[@]}" update
+          printf 'create_main_cluster = false\n' | sudo tee /etc/postgresql-common/createcluster.conf >/dev/null
+          sudo apt-get "${pg_apt[@]}" install -y --no-install-recommends postgresql-17
+      # Runs as the runner user (non-root), exactly as the ci.yml step would.
+      - name: Currency meter reads what is owed and runs on its own
+        env:
+          PG_BIN: /usr/lib/postgresql/17/bin
+        run: python3 scripts/ci/test-currency-meter-reads-what-is-owed.py --output artifacts/currency-meter-reads-what-is-owed
+      - name: Retain the regression evidence
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: currency-meter-reads-what-is-owed-${{ github.run_id }}-${{ github.run_attempt }}
+          path: artifacts/currency-meter-reads-what-is-owed/RESULTS.json
+          retention-days: 7
+          if-no-files-found: warn
