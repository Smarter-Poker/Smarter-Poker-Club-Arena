+/* Two short waits inside one hand boundary, the same budget the post-hand
+   step retry uses (ServerTableEngineSettlement STEP_RETRY_BACKOFF_MS). */
+const DEPARTURE_READ_RETRY_MS = [250, 1_000];
+const PRE_EXECUTION_POSTGREST_CODES = new Set(['PGRST001', 'PGRST002', 'PGRST003']);
+
+/**
+ * A returned read error that the DATABASE did not give: no SQLSTATE and no
+ * PostgREST answer code (a gateway 502/504 HTML page, an empty body), or
+ * PostgREST's own "the statement never ran" 503 codes. Only for reads: a
+ * write that met a gateway error may have committed, and is never asked
+ * again on this basis.
+ */
+export function isGatewayReadFailure(error: { code?: unknown } | null | undefined): boolean {
+  if (!error) return false;
+  const code = error.code;
+  if (code === null || code === undefined || code === '') return true;
+  return typeof code === 'string' && PRE_EXECUTION_POSTGREST_CODES.has(code);
+}
