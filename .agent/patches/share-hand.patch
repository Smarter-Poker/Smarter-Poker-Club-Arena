+function decodeActions(str: string | undefined): ShareableAction[] {
+  const out: ShareableAction[] = [];
+  if (!str) return out;
+  for (const token of str.split(',')) {
+    if (token.length < 2) continue;
+    const seat = parseInt(token[0], 10);
