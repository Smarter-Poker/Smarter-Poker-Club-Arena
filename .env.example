# ═══════════════════════════════════════════════════════════════════════════════
# CRITICAL: These 3 env vars MUST be set in Vercel dashboard for production.
# If any are missing, the app renders the SystemOffline diagnostic screen.
# ═══════════════════════════════════════════════════════════════════════════════

# Anti-Gravity Boot Gate (MUST be "true" in all environments)
VITE_ANTIGRAVITY_ENABLED=true

# Supabase Configuration (PokerIQ-Production)
VITE_SUPABASE_URL=https://kuklfnapbkmacvwxktbh.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Application Environment
VITE_APP_ENV=development

# Authoritative game-engine WebSocket. The client applies live hand state ONLY
# from the Hetzner engine over WS (the client-side engine was removed). This
# defaults ON; set to "0" to opt a build out (e.g. a UI-only preview with no
# engine). A blank/absent value = ON.
VITE_USE_ENGINE_WS=1

# Secret Keys (NEVER prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=your-db-password
SUPABASE_ACCESS_TOKEN=your-access-token
MASTERY_SEAL_SECRET=your-mastery-seal-secret

# POY endpoints are same-origin (/api/club-arena/results, /api/poy/leaderboard)
# No client-side API key needed — auth via Supabase JWT

# Sentry Error Tracking & Performance Monitoring
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=smarter-poker
SENTRY_PROJECT=club-arena
VITE_APP_VERSION=1.0.0

# Test account used by Playwright e2e and the browser-testing workflows.
# 2026-08-15: this was hardcoded in 42 tracked files in a PUBLIC repo. Never
# inline it again — read it from the environment.
TEST_USER_EMAIL=daniel@bekavactrading.com
TEST_USER_PASSWORD=
