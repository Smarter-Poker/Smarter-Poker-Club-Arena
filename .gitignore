# Dependencies
node_modules

# Build
dist
coverage

# Vercel
.vercel

# Supabase
supabase/.temp

# Environment — NEVER track any .env file with real secrets
.env
.env.*
!.env.example
.env.local
.env.*.local
.env.check

# Secrets that are not .env files (2026-08-21). A token was saved to
# github_token.md beside the .env, untracked but NOT ignored - one `git add -A`
# from any of the agents that run here constantly would have committed it.
# GitHub auto-revokes leaked tokens, so the damage is an outage, not just an
# exposure. Ignore the shapes, not one filename.
github_token.md
*token*.md
*secret*.md
*credentials*.md
.env.vercel
.env.prod.check

# IDE
.idea
.vscode
*.swp
*.swo
.DS_Store
# Generated PioSolver trees (regeneratable)
scripts/trees/
server/vitest.config.ts.timestamp-*.mjs

# Debug/test build outputs (e.g. dist-bug021, dist-hotfix, etc.)
# These are one-off build snapshots that agents create during debugging.
# They contain 500+ files each and cause VS Code to show 1K+ phantom changes.
dist-*/
dist.dead.*/
.vercel/output/
*.local

# Agent brain artifacts (may contain tokens, session data)
.gemini/

# Agent memory/context files (tracked selectively, not bulk)
# Uncomment below if you want to gitignore all .memory files:
# .memory/
.ssh/

*.stale.*
**/*.stale.*/

# Round 19 — local-only artifacts that shouldn't ship
.agent/openclaw-dispatcher-live-*.py
playwright-report/
# Playwright failure artifacts: screenshots, videos, trace zips. 4.2 MB after a
# single failing run, and only playwright-report/ was ignored - so any blanket
# `git add -A` (git-safe-push.sh does this) would have committed them.
test-results/

# Scratch/quarantine dir. device_bash on the mounted volume cannot unlink,
# so stale locks and old build dirs get parked here instead of deleted.
_to_delete/

# Staging area for moving code between the sandbox and the host. Held a 12 MB
# ca-code.tgz that a blanket `git add -A` would otherwise have committed.
.upload-scratch/
# One-off Playwright probe scripts written to the repo root while debugging.
_v*.mjs

# Scratch space for ad-hoc production probes (screenshots, one-off .mjs).
# The COMMITTED walkthrough suite is e2e-live/ — 4.4 MB of throwaway probes and
# a 232-line-stale duplicate of multitable-walk.mjs were tracked here, which is
# exactly how the next person edits the wrong copy.
e2e-work/

# Playwright's authenticated storageState, written fresh by
# tests/e2e/global-setup.ts on every run. Never commit a session token.
tests/e2e/.auth/

# FUSE mount artifacts. The Cowork/device sandbox mounts this repo over FUSE,
# which cannot unlink a file that is still open — the kernel renames it to
# .fuse_hiddenXXXXXXXX instead and leaves it behind. Three of these were sitting
# untracked in src/ on 2026-08-21, one `git add -A` away from being committed.
# They are never source. Same story as _to_delete/ above.
.fuse_hidden*

# One-off debug screenshots dropped at the repo root (_cards_probe.png, etc).
# The committed visual suite is e2e-live/; these are throwaways.
_*_probe.png

# Ad-hoc one-shot Python rewriters dropped at the repo root while iterating on
# CSS/JSX (patch_cardimage.py, update_css.py, ...). They encode a single edit
# that has already been applied and are meaningless afterwards, but `git add -A`
# will happily commit them. The durable form of such a change is the diff it
# produced, not the script that produced it.
/patch_*.py
/update_css.py
/fix_*.py

# Root-level probe leftovers: bare screenshots and dotfile scratch written by
# ad-hoc production checks. Same rationale as _*_probe.png above.
/.e2e.png
/.ca_probe_*
