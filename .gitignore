# Dependencies
node_modules

# Build
dist
coverage

# Vercel
.vercel

# Supabase
supabase/.temp

# Environment — NEVER track any .env file with real secrets
.env
.env.*
!.env.example
.env.local
.env.*.local
.env.check
.env.vercel
.env.prod.check

# IDE
.idea
.vscode
*.swp
*.swo
.DS_Store
# Generated PioSolver trees (regeneratable)
scripts/trees/
server/vitest.config.ts.timestamp-*.mjs

# Debug/test build outputs (e.g. dist-bug021, dist-hotfix, etc.)
# These are one-off build snapshots that agents create during debugging.
# They contain 500+ files each and cause VS Code to show 1K+ phantom changes.
dist-bug*/
dist-hotfix*/
dist-test*/

# Agent brain artifacts (may contain tokens, session data)
.gemini/

# Agent memory/context files (tracked selectively, not bulk)
# Uncomment below if you want to gitignore all .memory files:
# .memory/
.ssh/
