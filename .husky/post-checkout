#!/bin/bash
# THE MOMENT AFTER A HEAD MOVE — SAVE THE TREE, THEN SAY SO.
#
# WHAT THIS REPLACES, and why it never did anything (2026-08-23):
#
#   The previous version grepped the reflog for "reset: moving to origin/main"
#   and, on a match, ran `git reset --hard $PREV` to undo it. Two faults, each
#   fatal on its own:
#     1. post-checkout DOES NOT FIRE ON `git reset`. Not on any form of it.
#        The branch it guarded was unreachable from the day it was written.
#     2. A bare `git reset --hard` writes "reset: moving to HEAD", not
#        "...to origin/main", so even where the string was reachable it did
#        not match the shape that actually destroys work.
#   It also only ever looked at COMMITS (`git log origin/main..$PREV`), which
#   is the one thing already covered by .husky/reference-transaction.
#
# WHAT LOSES WORK HERE is uncommitted files in the SHARED CLONE. A working tree
# has one HEAD, one index and one set of uncommitted files; when a second agent
# checks out a branch in it, agent A's edits either ride along or are left
# behind, and neither agent is told. Nothing can prevent that from inside a
# hook - post-checkout runs after the switch, and git offers nothing before it.
#
# So this does the two things that ARE possible after the fact:
#   1. SNAPSHOT. `git stash create` builds commit objects and prints a sha
#      without touching the index, the working tree or the stash stack, so it
#      is safe to run at any moment, including mid-edit. Stored under
#      refs/wip/, which `git reset --hard` cannot reach.
#   2. SAY SO. The 10-minute launchd snapshotter already covers the timer case;
#      what nobody had was being TOLD, at the moment it mattered, that they are
#      working somewhere their work will not survive.
#
# It never blocks and never moves anybody. Refusing a checkout, or "restoring"
# a HEAD as the old version tried to, is itself a way to destroy work.
PREV="$1"
NEW="$2"
BRANCH_SWITCH="$3"

# File checkouts (`git checkout -- path`) pass 0 and are not a HEAD move.
[ "$BRANCH_SWITCH" = "1" ] || exit 0
[ -n "${CI:-}${GITHUB_ACTIONS:-}" ] && exit 0

GIT_DIR=$(git rev-parse --path-format=absolute --git-dir 2>/dev/null || echo "")
COMMON_DIR=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || echo "")
[ -n "$GIT_DIR" ] && [ -n "$COMMON_DIR" ] || exit 0

# A linked worktree has its own git dir under <common>/worktrees/<name>; they
# are equal only in the shared clone. Agents in their own tree are fine by
# construction and must not be nagged.
[ "$GIT_DIR" = "$COMMON_DIR" ] || exit 0

# Tracked modifications only. Untracked files survive both a checkout and a
# `git reset --hard`, and `git stash create` does not carry them anyway.
DIRT=$(git status --porcelain --untracked-files=no 2>/dev/null | head -1)
[ -n "$DIRT" ] || exit 0

SNAP=""
WT=$(git stash create "post-checkout guard: shared clone was dirty" 2>/dev/null) || WT=""
if [ -n "$WT" ]; then
  SNAP="refs/wip/shared-clone/$(date -u +%Y%m%dT%H%M%SZ)"
  git update-ref "$SNAP" "$WT" 2>/dev/null || SNAP=""
fi

REPO_ROOT=${COMMON_DIR%/.git}
AGENT=${AGENT_NAME:-$(whoami)}
COUNT=$(git status --porcelain --untracked-files=no 2>/dev/null | wc -l | tr -d ' ')

{
  echo ""
  echo "  ─────────────────────────────────────────────────────────────────────"
  echo "  UNCOMMITTED WORK IN THE SHARED CLONE - $COUNT tracked file(s)"
  echo ""
  echo "    $REPO_ROOT"
  echo ""
  echo "  HEAD just moved here and those edits came with it. This tree is shared"
  echo "  by every agent on this Mac, and the next checkout or \`git reset --hard\`"
  echo "  will take them with nobody warned. That is not hypothetical - it is"
  echo "  where rescue/uncommitted-* branches come from."
  echo ""
  if [ -n "$SNAP" ]; then
    echo "  Saved just now, so nothing is lost either way:"
    echo "    $SNAP"
    echo "    git stash apply $SNAP"
  else
    echo "  A snapshot could not be taken. Commit or copy these files NOW."
  fi
  echo ""
  echo "  Get a tree of your own and work there instead:"
  echo "    eval \"\$(bash scripts/agent-workspace.sh $AGENT fix/describe-your-change)\""
  echo "  ─────────────────────────────────────────────────────────────────────"
  echo ""
} >&2

# Never block a checkout. Telling you is the whole job.
exit 0
