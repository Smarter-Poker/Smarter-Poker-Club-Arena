# One working tree per agent. Runs FIRST: if this commit should not be
# happening here at all, there is no point formatting it.
bash "$(git rev-parse --show-toplevel)/scripts/guard-shared-clone.sh"

# A commit Vercel cannot attribute never builds - the deployment goes to BLOCKED
# with no logs at all. Catch it here, not in CI after the deploy was refused.
bash "$(git rev-parse --show-toplevel)/scripts/guard-commit-identity.sh"

# FORMATTING IS BEST EFFORT; THE GUARDS ABOVE ARE NOT.
#
# Until 2026-08-23 this was a bare `npx lint-staged`. Agent worktrees have no
# node_modules, and npx on a missing package reaches for the NETWORK - so the
# moment hooks started actually running in worktrees (scripts/ensure-hooks.sh)
# this would have stalled every commit an agent makes. A gate people wait on is
# a gate people --no-verify past, and --no-verify also disables the two guards
# above, which are the ones that must never be skipped.
LS="$(git rev-parse --show-toplevel)/node_modules/.bin/lint-staged"
if [ -x "$LS" ]; then
  "$LS"
else
  echo "[pre-commit] no local node_modules - skipped formatting (guards above still ran)."
fi
