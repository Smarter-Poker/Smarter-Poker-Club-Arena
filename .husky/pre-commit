#!/usr/bin/env sh
# WITHOUT set -e A REFUSED COMMIT STILL LANDS.
#
# 2026-08-23: this file had no shebang and no set -e. git ran it through sh, so
# a guard below could print a full-page REFUSED banner, exit 1, and execution
# would simply continue to the next line. The hook's status is the status of
# its LAST command, so the commit was created anyway - with the banner sitting
# in the output as though it had stopped something.
#
# That was demonstrated live: guard-commit-identity.sh printed its refusal and
# the unattributable commit was made regardless. guard-shared-clone.sh, the
# one-worktree-per-agent rule, had been in the same position since it was
# written. Two guards, both correct, both unable to refuse anything.
set -e

# One working tree per agent. Runs FIRST: if this commit should not be
# happening here at all, there is no point formatting it.
# One clone per repo, before one worktree per agent - being in the wrong TREE
# makes the right worktree irrelevant.
bash "$(git rev-parse --show-toplevel)/scripts/check-canonical-clone.sh"

bash "$(git rev-parse --show-toplevel)/scripts/guard-shared-clone.sh"

# A commit Vercel cannot attribute never builds - the deployment goes to BLOCKED
# with no logs at all. Catch it here, not in CI after the deploy was refused.
bash "$(git rev-parse --show-toplevel)/scripts/guard-commit-identity.sh"

# The three guards above all PASSED a commit that deleted 3,708 of 3,710
# tracked files, and each was right to - none of them asks whether the tree is
# being emptied. See the script for what did that and how it got through.
bash "$(git rev-parse --show-toplevel)/scripts/guard-mass-deletion.sh"

# FORMATTING IS BEST EFFORT; THE GUARDS ABOVE ARE NOT.
#
# Until 2026-08-23 this was a bare `npx lint-staged`. Agent worktrees have no
# node_modules, and npx on a missing package reaches for the NETWORK - so the
# moment hooks started actually running in worktrees (scripts/ensure-hooks.sh)
# this would have stalled every commit an agent makes. A gate people wait on is
# a gate people --no-verify past, and --no-verify also disables the two guards
# above, which are the ones that must never be skipped.
LS="$(git rev-parse --show-toplevel)/node_modules/.bin/lint-staged"
if [ -x "$LS" ]; then
  "$LS"
else
  echo "[pre-commit] no local node_modules - skipped formatting (guards above still ran)."
fi
