#!/usr/bin/env bash
# Club Arena pre-push hook — Phase 6 consolidation gate (2026-04-27)
#
# Blocks pushes that:
#   1. Contain merge-conflict markers (lesson from f490f61bf)
#   2. Introduce vercel.json crons (Open Claw exclusive policy)
#   3. Introduce client-side PIN-gate storage (Phase 3.6 server-side only)
#   4. Use raw supabase.auth.getUser() outside src/lib/authUtils.ts
#
# Bypass with `git push --no-verify` only in genuine emergencies.

set -e

# ── One working tree per agent (rule 1a) ────────────────────────────────────
# Runs FIRST, for the same reason it runs first on pre-commit: if this push
# should not be coming from this tree at all, none of the content checks below
# matter. git-safe-push.sh and the World Hub sync export AGENT_SHARED_CLONE_OK=1
# because they legitimately push from the one-and-only tree; CI is exempt too.
#
# Added 2026-08-23. Commit-only enforcement missed the shape that actually
# loses work: an agent edits in the shared clone, never commits there, and the
# next checkout or `git reset --hard` takes the lot with nobody warned.
bash "$(git rev-parse --show-toplevel)/scripts/guard-shared-clone.sh" push

REMOTE="$1"
URL="$2"
FAIL=0

# ── node must be findable, and a missing node must not masquerade as a
# content failure (2026-08-23).
#
# A push from a shell without /opt/homebrew/bin on PATH ran
# `node scripts/ci/check-title-case.mjs`, which exited 127 command-not-found,
# and this hook announced:
#
#     check-title-case FAILED: page copy is not Title Cased.
#
# The copy was fine; node was absent. The agent's commit stayed unpushed -
# the one state this estate cannot afford - and the message sent them to look
# at the wrong thing entirely. The REAL blocker on that push only became
# visible once node was found: a genuine supabase.auth.getUser() violation,
# which check 4 below then reported correctly. A false failure had been
# standing in front of a true one.
#
# World Hub's Club Arena bundle gate had the identical bug the same day,
# announcing "STALE or INCOMPLETE bundle" when node was simply missing
# (WH #664).
#
# node's DIRECTORY goes on PATH rather than resolving a single binary, so that
# child processes inherit it too - npx is itself a node script and fails its
# own shebang with `env: node: No such file or directory` otherwise.
if ! command -v node >/dev/null 2>&1; then
  for d in /opt/homebrew/bin /usr/local/bin; do
    [ -x "$d/node" ] && PATH="$d:$PATH" && export PATH && break
  done
fi
if ! command -v node >/dev/null 2>&1; then
  echo "[club-arena pre-push] BLOCKED: node was not found on PATH, so the"
  echo "  JavaScript checks below cannot run. This is NOT a content failure."
  echo "  Re-run with node available, for example:"
  echo "      PATH=\"/opt/homebrew/bin:\$PATH\" git push -u origin HEAD"
  exit 1
fi

# Get the range of commits being pushed
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  # Skip deletions
  if [ "$LOCAL_SHA" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  if [ "$REMOTE_SHA" = "0000000000000000000000000000000000000000" ]; then
    # New branch — check all commits up to current
    RANGE="$LOCAL_SHA"
    FILES=$(git diff --name-only "$LOCAL_SHA")
  else
    # ─────────────────────────────────────────────────────────────────────
    # THE REMOTE TIP MAY NOT BE IN THIS CLONE, AND THAT IS NORMAL HERE.
    #
    # Agents work in worktrees from scripts/agent-workspace.sh and sync with
    # `git fetch origin main`, which does NOT fetch other branches. Autopilot
    # meanwhile pushes merge commits onto agent branches to keep them fresh,
    # so the remote tip of YOUR OWN branch is routinely a commit you have
    # never seen.
    #
    # Until 2026-08-23 the next line ran `git diff` against it with `set -e`
    # still in force, so the hook died on its first instruction with a bare
    #
    #     fatal: bad object 73ea7423e942f8c91ed417fd8f23124f5eefd307
    #     husky - pre-push script failed (code 128)
    #
    # before a single house rule or test had run. The message names nothing,
    # suggests nothing, and points at no file. It cost a real debugging cycle
    # to trace to this line.
    #
    # The danger is not the wasted time. The obvious way out of an
    # inscrutable pre-push failure is --no-verify, and every rule below this
    # point exists because something was lost. A guard whose failure mode
    # invites its own bypass is worse than no guard.
    #
    # So: fetch it, and if it still is not here, check against main instead.
    # Never die, and never silently check nothing.
    # ─────────────────────────────────────────────────────────────────────
    if ! git cat-file -e "${REMOTE_SHA}^{commit}" 2>/dev/null; then
      git fetch -q "$REMOTE" "$REMOTE_SHA" 2>/dev/null || true
    fi
    if git cat-file -e "${REMOTE_SHA}^{commit}" 2>/dev/null; then
      RANGE="$REMOTE_SHA..$LOCAL_SHA"
      FILES=$(git diff --name-only "$REMOTE_SHA" "$LOCAL_SHA" 2>/dev/null || true)
    else
      BASE=$(git merge-base "$LOCAL_SHA" "$REMOTE/main" 2>/dev/null \
             || git merge-base "$LOCAL_SHA" main 2>/dev/null || true)
      if [ -n "$BASE" ]; then
        echo "[club-arena pre-push] NOTE: the remote tip of this branch"
        echo "                      ($REMOTE_SHA)"
        echo "                      is not in this clone, so there is nothing to diff it"
        echo "                      against. Checking everything since main instead —"
        echo "                      a WIDER check, never a skipped one."
        echo "                      (A plain \`git fetch $REMOTE\` brings it in.)"
        RANGE="$BASE..$LOCAL_SHA"
        FILES=$(git diff --name-only "$BASE" "$LOCAL_SHA" 2>/dev/null || true)
      else
        echo "[club-arena pre-push] NOTE: no common base with main could be found."
        echo "                      Checking the whole tree rather than nothing."
        RANGE="$LOCAL_SHA"
        FILES=$(git ls-files 2>/dev/null || true)
      fi
    fi
  fi

  # ═══════════════════════════════════════════════════════════════════════
  # 5. NON-FAST-FORWARD PUSH TO main — added 2026-08-21 after a real loss.
  #
  # WHAT HAPPENED: main was rewound to ada755ab3 and four commits that were
  # already built, synced and SERVING IN PRODUCTION were dropped from it:
  # 5d42741e4 (seat-as-reservation), d884f5fd2 (BBJ palette re-land),
  # ea6d53082 (throwables sizing) and e0f707a09 (the case-sensitivity CI
  # fix). Production was left running code that main no longer contained,
  # so the next sync would have quietly deleted four features. The round-8
  # changelog on main still described that work as shipped, which is how you
  # know it was an accident and not a revert — nobody writes a changelog for
  # work they meant to drop.
  #
  # WHY A HOOK AND NOT BRANCH PROTECTION: branch protection is unavailable on
  # a private repo without GitHub Pro (see the note under check 0). Server
  # side there is nothing left to refuse a force-push, so the last place it
  # can be caught is here, on the machine doing it.
  #
  # This is deliberately not a lint. Every other check in this file is about
  # the CONTENT of a push; this one is about whether the push DESTROYS
  # published history. Losing commits is the only failure here that cannot
  # be fixed forward by another commit.
  case "$REMOTE_REF" in
    refs/heads/main)
      if [ "$REMOTE_SHA" != "0000000000000000000000000000000000000000" ]; then
        # The remote tip must be reachable from what we are about to push.
        # If it is not, this push deletes commits that are already on main.
        if ! git cat-file -e "$REMOTE_SHA" 2>/dev/null; then
          git fetch -q "$REMOTE" "$REMOTE_SHA" 2>/dev/null || true
        fi
        if ! git cat-file -e "$REMOTE_SHA" 2>/dev/null; then
          echo "[club-arena pre-push] BLOCKED: cannot verify this push is fast-forward."
          echo "                      The current remote tip ($REMOTE_SHA) is not in"
          echo "                      this clone, so whether it drops commits is unknowable."
          echo "                      Run: git fetch $REMOTE main   then push again."
          FAIL=1
        elif ! git merge-base --is-ancestor "$REMOTE_SHA" "$LOCAL_SHA" 2>/dev/null; then
          DROPPED=$(git rev-list --count "$LOCAL_SHA..$REMOTE_SHA" 2>/dev/null || echo "?")
          echo ""
          echo "[club-arena pre-push] BLOCKED: this push REWINDS main."
          echo ""
          echo "  Remote main is at $REMOTE_SHA, which is NOT an ancestor of what you"
          echo "  are pushing. $DROPPED commit(s) currently on main would stop existing."
          echo ""
          echo "  Commits that would be dropped:"
          git log --oneline --max-count=15 "$LOCAL_SHA..$REMOTE_SHA" 2>/dev/null | sed 's/^/    /'
          echo ""
          echo "  This is how four production-serving commits were lost on 2026-08-21."
          echo "  Almost always the fix is to REBASE ONTO them rather than over them:"
          echo ""
          echo "      git pull --rebase $REMOTE main && git push"
          echo ""
          echo "  If you are deliberately reverting, revert with a commit - that keeps"
          echo "  the history and is reviewable. A rewind leaves no trace of what went."
          echo ""
          echo "  Genuine emergency override:  CA_ALLOW_MAIN_REWIND=1 git push ..."
          echo ""
          if [ "${CA_ALLOW_MAIN_REWIND:-0}" = "1" ]; then
            echo "  [CA_ALLOW_MAIN_REWIND=1 set - allowing this rewind]"
          else
            FAIL=1
          fi
        fi
      fi
      ;;
  esac

  # 0. Repo-wide invariants. Both are ~100ms.
  #
  #    CORRECTED 2026-08-28. This comment used to say branch protection was
  #    unavailable without GitHub Pro and that "nothing enforces it server-side
  #    any more". Checked against the API: ruleset `main protection` (21163380)
  #    is ACTIVE on main with `bypass_actors: []` and six required checks. It
  #    enforces. These two guards run here because catching them in 100ms beats
  #    catching them in a three-minute CI cycle, not because nothing else will.
  if [ -f scripts/ci/check-allin-pointer-events.mjs ]; then
    if ! node scripts/ci/check-allin-pointer-events.mjs; then
      echo "[club-arena pre-push] BLOCKED: all-in action panel would lose pointer events"
      FAIL=1
    fi
  fi
  if [ -f scripts/ci/check-monitoring-drift.mjs ]; then
    if ! node scripts/ci/check-monitoring-drift.mjs; then
      echo "[club-arena pre-push] BLOCKED: monitoring wiring is broken"
      FAIL=1
    fi
  fi
  # A commit carrying [skip ci] starts NO workflow run, so the bundle is never
  # built and production keeps serving the previous one with nothing red
  # anywhere. Every other net in the estate RECOVERS from that; this one
  # prevents it. Real precedent: 454fa1da4.
  if [ -f scripts/ci/check-no-skip-markers.mjs ]; then
    if ! node scripts/ci/check-no-skip-markers.mjs; then
      echo "[club-arena pre-push] BLOCKED: a commit would suppress its own publish"
      FAIL=1
    fi
  fi
  # A SECURITY DEFINER function that writes and that a browser can call must
  # consult the request. Nineteen did not on 2026-08-27; one let any member
  # rewrite a club's member_count, another pays chips. Scoped to the migrations
  # this branch adds, because supabase/migrations/ is intentionally stale.
  # An insert that omits a NOT NULL column with no default cannot land, and the
  # error lands in a catch. Whole-tree and currently at zero, so any new one is
  # this push's doing.
  if [ -f scripts/ci/check-required-columns.mjs ]; then
    if ! node scripts/ci/check-required-columns.mjs; then
      echo "[club-arena pre-push] BLOCKED: an insert omits a column its table requires."
      FAIL=1
    fi
  fi
  if [ -f scripts/ci/check-definer-authorization.mjs ]; then
    DEF_BASE=$(git merge-base HEAD origin/main 2>/dev/null || echo "HEAD~1")
    if ! node scripts/ci/check-definer-authorization.mjs "$DEF_BASE"; then
      echo "[club-arena pre-push] BLOCKED: a SECURITY DEFINER writer a browser can reach"
      echo "                      never asks who is calling. See the remedy above."
      FAIL=1
    fi
  fi

  # 0b. TYPE CHECK — added 2026-08-27, re-justified 2026-08-28.
  #
  #    THIS IS FAST FEEDBACK, NOT ENFORCEMENT. Be clear about that, because the
  #    commit that added it was not: it claimed a direct push to main went
  #    unchecked and that this hook was the only gate left. Both were wrong.
  #    The `main protection` ruleset requires a pull request and six green
  #    checks, `TypeScript Check` among them, and nobody bypasses it — so a
  #    type error has never been able to reach main.
  #
  #    What it buys is the three minutes between pushing a branch and CI
  #    telling you what tsc would have told you in four seconds. That is worth
  #    a hook; pretending it is the last line of defence is not.
  #
  #    COST: about 40s cold, about 4s warm — tsconfig.json already sets
  #    `incremental` with a tsBuildInfoFile, so only the first run pays. Runs
  #    at all only when the push touches src/**.ts(x).
  #
  #    It SKIPS, loudly, when a worktree has no node_modules — same reasoning
  #    as the formatter in .husky/pre-commit: a gate people wait on is a gate
  #    people --no-verify past, and --no-verify also disables the rewind guard
  #    in check 5, which must never be skipped.
  if echo "$FILES" | grep -qE '^src/.*\.tsx?$'; then
    TSC="$(git rev-parse --show-toplevel)/node_modules/.bin/tsc"
    if [ -x "$TSC" ]; then
      echo "[club-arena pre-push] type-checking src/ ..."
      if ! "$TSC" --noEmit; then
        echo ""
        echo "[club-arena pre-push] BLOCKED: src/ does not type-check."
        echo "                      Fix the errors above. CI's TypeScript Check"
        echo "                      is a required check and would refuse this"
        echo "                      pull request anyway - this just tells you"
        echo "                      now instead of in three minutes."
        FAIL=1
      fi
    else
      echo "[club-arena pre-push] no local node_modules - skipped the type check."
    fi
  fi

  # 1. Merge conflict markers
  for f in $FILES; do
    if [ -f "$f" ]; then
      if grep -nE '^(<<<<<<< |>>>>>>> |={7,}$)' "$f" >/dev/null 2>&1; then
        echo "[club-arena pre-push] BLOCKED: $f contains a merge-conflict marker"
        FAIL=1
      fi
    fi
  done

  # 2. vercel.json crons (policy: Open Claw exclusive)
  for f in $FILES; do
    case "$f" in
      *vercel.json)
        if [ -f "$f" ] && grep -q '"crons"' "$f"; then
          echo "[club-arena pre-push] BLOCKED: $f introduces a Vercel crons block"
          echo "                      Use Open Claw → workers exclusively."
          FAIL=1
        fi
        ;;
    esac
  done

  # 3. Client-side PIN-gate storage (Phase 3.6 forbids reintroducing this)
  for f in $FILES; do
    if [ -f "$f" ]; then
      case "$f" in
        *src/lib/auth/*) continue ;;
      esac
      if grep -qE "localStorage\.(set|get)Item\(['\"](commanderAdminPin|admin_pin|club_admin_pin)" "$f" 2>/dev/null; then
        echo "[club-arena pre-push] BLOCKED: $f reintroduces client-side PIN storage"
        echo "                      Phase 3.6 moved PIN validation server-side."
        FAIL=1
      fi
    fi
  done

  # 4. Raw supabase.auth.getUser() outside the canonical auth module
  #
  # 2026-08-21: this rule was unenforceable as written. It told you to "use
  # validateBearer() from src/lib/auth", but `src/lib/auth/` has never existed
  # in this repo's history and `validateBearer` has never been defined
  # anywhere. Phase 6 Rule 4 named a migration target that was never built, so
  # the only way past this gate was --no-verify — which also switches off the
  # merge-conflict-marker check in the same hook, the one guard here that has
  # actually caught a production break (f490f61bf).
  #
  # The canonical module is src/lib/authUtils.ts, and the helper is
  # readLocalSession(): it parses the shared 'smarter-poker-auth' JWT, honours
  # expiry, and is already documented in-file as "the SINGLE canonical
  # implementation - all auth code should use this". The rule now names it.
  #
  # src/lib/supabase.ts is exempt on purpose: it is the SDK wrapper, and
  # somebody has to be allowed to call the SDK.
  #
  # Known remaining callers, not yet migrated (this gate only fires on files
  # you actually touch, so they are a to-do, not a wall):
  #   src/services/WalletService.ts        src/services/AvatarService.ts
  #   src/services/AgentService.ts         src/components/table/RealTimeResultPanel.tsx
  #   src/components/tournament/TournamentStartingTicker.tsx
  #   src/components/tournament/TournamentRankingCard.tsx
  for f in $FILES; do
    if [ -f "$f" ]; then
      case "$f" in
        *src/lib/authUtils*) continue ;;
        *src/lib/supabase.ts) continue ;;
          *node_modules/*) continue ;;
        *.husky/*) continue ;;
        # 2026-08-21: this gate is about CODE calling the raw auth API. It was
        # matching prose too, so MIGRATION-CHANGELOG.md — which QUOTES the
        # pattern in an audit entry from 2026 — blocked every push that
        # touched the changelog. Docs and data cannot call anything.
        *.md|*.markdown|*.txt|*.json|*.sql|*.lock) continue ;;
      esac
      if grep -qE 'supabase\.auth\.getUser\(\)' "$f" 2>/dev/null; then
        echo "[club-arena pre-push] BLOCKED: $f calls supabase.auth.getUser()"
        echo "                      use readLocalSession() from src/lib/authUtils instead."
        FAIL=1
      fi
    fi
  done
done

# ─────────────────────────────────────────────────────────────────────────────
# HOUSE TEXT RULES (Dan 2026-08-21)
#
#   "First letter of every word is capitalized, that's a hard rule for all
#    forward facing pages", and em dashes are forbidden.
#
# Both had a checker already, but it only ran in ci.yml - the workflow this
# repo's own notes say NEVER COMPLETES on main, because pushes land faster than
# its ~6 minutes and cancel-in-progress kills every run. A gate that never
# finishes is not a gate, so they run here, where the other house rules live.
# Together they take about two seconds.
#
# Autofix:  node scripts/ci/check-title-case.mjs --fix
#           node scripts/ci/check-ui-text.mjs --fix
# ─────────────────────────────────────────────────────────────────────────────
if [ -f scripts/ci/check-title-case.mjs ]; then
  if ! node scripts/ci/check-title-case.mjs; then
    FAIL=1
  fi
fi

# The third surface of the same rule: text painted from a string ATTRIBUTE or
# from a string literal inside a JSX EXPRESSION. Autofix:
#   node scripts/ci/check-painted-text-case.mjs --fix
if [ -f scripts/ci/check-painted-text-case.mjs ]; then
  if ! node scripts/ci/check-painted-text-case.mjs; then
    FAIL=1
  fi
fi

# The other half of the same rule. check-title-case.mjs inspects JsxText only
# and states in its own header that expression values "are cased at their
# source" - a promise nothing enforced. Every navigation surface renders its
# copy from a config registry through {item.label}, so 55 menu strings sat
# uncased for months in the gap between the two. Autofix:
#   node scripts/ci/check-nav-title-case.mjs --fix
if [ -f scripts/ci/check-nav-title-case.mjs ]; then
  if ! node scripts/ci/check-nav-title-case.mjs; then
    FAIL=1
  fi
fi

# Protected work must not be orphaned from main.
# Two of the 2026-08-21 throwables regressions were stale bundles (now covered
# by the World Hub provenance gate). The third was a commit that stopped being
# an ancestor of main because history was rewritten over it, and it passed
# every content-level guard: the source file, its imports and its registry
# entry vanished together, so the resulting main was self-consistent.
# The non-fast-forward check above stops the obvious force-push; this catches
# the work going missing by any route, including a merge resolved stale-side.
if [ -f scripts/ci/check-no-orphaned-work.mjs ]; then
  if ! node scripts/ci/check-no-orphaned-work.mjs; then
    echo "[club-arena pre-push] BLOCKED: protected work has been orphaned from main"
    FAIL=1
  fi
fi

if [ -f scripts/ci/check-ui-text.mjs ]; then
  if ! node scripts/ci/check-ui-text.mjs; then
    FAIL=1
  fi
fi

# ═════════════════════════════════════════════════════════════════════════════
# 10. THE TEST SUITE — THE ONE GATE THAT WAS MISSING (Dan, 2026-08-21)
#
# On 2026-08-21 main sat unable to deploy FOUR separate times, every one of
# them a red test pushed alongside the feature it was meant to guard:
#
#   - tests/tip-dealer-guards.test.tsx imported a component deleted the day
#     before, so it failed at transform time from the moment it landed.
#   - tests/unit/handCompletionLaw.test.ts read src/services/soundService.ts.
#     The file is SoundService.ts. macOS resolved it; Linux CI did not.
#   - tests/unit/winningCardHighlight.test.ts asserted that the engine sends
#     card_indices. The engine has never contained that string. It was a
#     specification committed with no implementation beside it - by a commit
#     whose own message was "unblock the deploy gate".
#   - tests/actionpanel-raise-presets.test.ts still asserted the rounding rule
#     that the same commit's feature had just replaced.
#
# Each one blocked EVERY agent and every deploy until a human noticed, because
# `npx vitest run tests/` in publish-club-arena.yml is what publishes the
# bundle. This hook already enforces nine house rules about the CONTENT of a
# push and never once ran the tests.
#
# WHY TARGETED AND NOT THE WHOLE SUITE: the full run is minutes; `vitest
# related` on the files you actually touched is about four seconds, and it
# would have caught all four incidents above - three of them changed a test
# file (run directly), the fourth changed ActionPanel.tsx (found by related).
# A gate people wait minutes for is a gate people start bypassing.
#
# Emergency bypass:  CA_SKIP_TESTS=1 git push
# ═════════════════════════════════════════════════════════════════════════════
# 2026-08-23: gated on a LOCAL vitest. This hook ran in NONE of the 38 agent
# worktrees whose core.hooksPath pointed at the gitignored .husky/_ (see
# scripts/ensure-hooks.sh). Restoring it there would have run the suite through
# the npx package fetcher in a tree with no node_modules - a network round trip
# on every push. scripts/agent-workspace.sh links node_modules in, so this
# normally runs; when it truly cannot, it says so rather than letting a suite
# that never ran look like a suite that passed.
# A GUTTED node_modules LOOKS LIKE A BROKEN REPO. It is not.
#
# Every worktree shares the main clone's node_modules through a symlink, and an
# `npm install` run inside ANY tree writes through it. Twice on 2026-08-23 that
# left ~285 package directories empty, and every hook on the machine then died
# on check-title-case.mjs with ERR_MODULE_NOT_FOUND - a message that names a
# path and explains nothing. An agent seeing it reasonably concludes their own
# tree is broken and starts reinstalling, which is how it becomes a loop.
#
# Probe first, so the diagnosis arrives before the confusion does.
bash "$(git rev-parse --show-toplevel)/scripts/check-node-modules.sh" --check || true

VITEST="$(git rev-parse --show-toplevel)/node_modules/.bin/vitest"

# 2026-08-25: REPAIR IT, DO NOT NARRATE IT — corrected same day.
#
# This used to print a WARNING and push anyway, which meant the one rule that
# stops a red test blocking the World Hub bundle was a printed sentence in the
# 124 of 162 trees that had no server/node_modules.
#
# The first attempt at repairing it carried four defects worth recording,
# because each is a shape that recurs:
#
#   - it copied with `cp -R src dst` while `dst` might already exist, which
#     nests into node_modules/node_modules and leaves a tree that every later
#     `[ -e ]` check calls "provisioned" forever. Copy to a temp and rename.
#   - it refused when run IN the main clone, which is where git-safe-push.sh
#     and the World Hub sync push from. A guard that can brick the deploy path
#     is worse than the hole it closes. That case now advises `npm ci` and
#     does not block.
#   - it had no CI exemption, unlike every other guard in this file.
#   - it read `[ -z "$CA_SKIP_TESTS" ]`, so CA_SKIP_TESTS=0 SKIPPED the gate —
#     the opposite of what the message it prints says. Compare to "1".
CA_IN_CI=0
[ -n "${CI:-}" ] && CA_IN_CI=1
[ -n "${GITHUB_ACTIONS:-}" ] && CA_IN_CI=1

CA_TESTS_ON=1
[ "${CA_SKIP_TESTS:-0}" = "1" ] && CA_TESTS_ON=0
[ "$CA_IN_CI" = "1" ] && CA_TESTS_ON=0

CA_ROOT_MAIN="$HOME/Documents/club-arena"
CA_TREE_TOP="$(git rev-parse --show-toplevel)"

# Same repository only. A second full clone of this remote exists on this
# machine and its node_modules answers to a different package-lock.
ca_same_repo() {
  [ -d "$CA_ROOT_MAIN/.git" ] || [ -f "$CA_ROOT_MAIN/.git" ] || return 1
  [ "$(git -C "$CA_ROOT_MAIN" rev-parse --git-common-dir 2>/dev/null)" = "$(git rev-parse --git-common-dir 2>/dev/null)" ]
}

# Clone one package root's deps in, atomically. Never copies onto an existing
# directory, so a gutted or half-copied tree is replaced rather than nested.
ca_provision() {
  src="$1"; dst="$2"
  [ -d "$src" ] || return 1
  rm -rf "$dst.provision.$$" 2>/dev/null
  if cp -Rc "$src" "$dst.provision.$$" 2>/dev/null || cp -R "$src" "$dst.provision.$$" 2>/dev/null; then
    rm -rf "$dst" 2>/dev/null
    mv "$dst.provision.$$" "$dst" 2>/dev/null && return 0
  fi
  rm -rf "$dst.provision.$$" 2>/dev/null
  return 1
}

if [ "$CA_TESTS_ON" = "1" ] && [ -f package.json ] && [ ! -x "$VITEST" ]; then
  if [ "$CA_TREE_TOP" = "$CA_ROOT_MAIN" ]; then
    echo ""
    echo "[club-arena pre-push] this clone's node_modules is missing or gutted, so the"
    echo "                      test gate cannot run. NOT refusing: git-safe-push.sh and"
    echo "                      the World Hub sync push from here, and bricking that is"
    echo "                      worse than the gate being down for one push."
    echo "                      Repair it:  (cd $CA_ROOT_MAIN && npm ci)"
    echo ""
  elif ca_same_repo && ca_provision "$CA_ROOT_MAIN/node_modules" "$CA_TREE_TOP/node_modules"; then
    echo "[club-arena pre-push] no local vitest - provisioned from the main clone so the gate can run."
  fi
fi

if [ "$CA_TESTS_ON" = "1" ] && [ -f package.json ] && [ ! -x "$VITEST" ] \
   && [ "$CA_TREE_TOP" != "$CA_ROOT_MAIN" ]; then
  echo ""
  echo "[club-arena pre-push] REFUSING: no vitest in this tree and it could not be"
  echo "                      provisioned, so the test gate cannot run. Pushing now"
  echo "                      would put an ungated commit on a branch CI publishes"
  echo "                      from."
  echo "                      Fix:  bash scripts/agent-workspace.sh <you> <slug>"
  echo "                      or:   npm ci"
  echo "                      Deliberate override: CA_SKIP_TESTS=1"
  echo ""
  exit 1
fi

if [ "$CA_TESTS_ON" = "1" ] && [ -f package.json ] && [ -x "$VITEST" ]; then
  CHANGED_TESTS=""
  CHANGED_SRC=""
  for f in $FILES; do
    [ -f "$f" ] || continue
    case "$f" in
      tests/*.test.ts|tests/*.test.tsx|tests/**/*.test.ts|tests/**/*.test.tsx)
        CHANGED_TESTS="$CHANGED_TESTS $f" ;;
      src/*.ts|src/*.tsx|server/src/*.ts|src/**/*.ts|src/**/*.tsx|server/src/**/*.ts)
        case "$f" in
          *.test.ts|*.test.tsx|*.d.ts) ;;
          *) CHANGED_SRC="$CHANGED_SRC $f" ;;
        esac ;;
    esac
  done

  if [ -n "$CHANGED_TESTS" ]; then
    echo "[club-arena pre-push] running the test files you changed..."
    if ! "$VITEST" run $CHANGED_TESTS; then
      echo ""
      echo "[club-arena pre-push] BLOCKED: a test you changed is failing."
      echo "                      A red test on main stops the World Hub bundle"
      echo "                      for EVERY agent, not just for you."
      echo ""
      echo "                      Writing the spec before the code is fine - but"
      echo "                      mark it it.skip() or describe.skip() until the"
      echo "                      implementation lands, so it documents the work"
      echo "                      without holding the deploy hostage."
      FAIL=1
    fi
  fi

  if [ -n "$CHANGED_SRC" ]; then
    echo "[club-arena pre-push] running the tests that cover your changes..."
    if ! "$VITEST" related --run $CHANGED_SRC; then
      echo ""
      echo "[club-arena pre-push] BLOCKED: your change breaks a test that covers it."
      echo "                      If the test pins behaviour you deliberately"
      echo "                      replaced, UPDATE the test in this same commit."
      echo "                      Leaving it red blocks every deploy until"
      echo "                      somebody else finds it."
      FAIL=1
    fi

    # THE PINS (2026-09-02). `vitest related` follows IMPORTS. A source pin
    # does not import the file it pins - it readFileSync()s it - so `related`
    # has never once run a pin for the file it reads. 96 files under tests/
    # read server/src/** that way. #2695 changed isPausedByDesign() in
    # ServerTableEngineBase.ts, this hook ran `related` on it, found nothing,
    # let it through, and tests/unit/tournamentRakeAndBreaks.test.ts went red
    # on main. Run every test under tests/ that names a changed file, too.
    PINNED=""
    for f in $CHANGED_SRC; do
      base=$(basename "$f")
      for t in $(grep -rl --include='*.test.ts' --include='*.test.tsx' -F "$base" tests/ 2>/dev/null); do
        case " $PINNED $CHANGED_TESTS " in *" $t "*) ;; *) PINNED="$PINNED $t" ;; esac
      done
    done
    if [ -n "$PINNED" ]; then
      echo "[club-arena pre-push] running the pins that READ a file you changed..."
      if ! "$VITEST" run $PINNED; then
        echo ""
        echo "[club-arena pre-push] BLOCKED: a test that reads a file you changed is red."
        echo "                      It pins the source text. If you deliberately"
        echo "                      changed what it pins, move the pin in this"
        echo "                      same commit - never leave it for the merge."
        FAIL=1
      fi
    fi
  fi
fi

# ── THE SERVER GATE (2026-08-25) ──
#
# server/ is its OWN vitest project: server/vitest.config.ts includes
# 'src/**/*.test.ts', while the root config includes only 'tests/**'. So the
# gate above — which runs the ROOT vitest — can never execute a single one of
# the 137 server test files, whatever it is handed. A changed
# server/src/x.test.ts matched no branch at all, and a changed server/src/x.ts
# was passed to `vitest related` in a project that does not know those tests
# exist.
#
# The engine is the highest-stakes code in this repository and it was the one
# part with NO pre-push test gate. The first version of this change provisioned
# server/node_modules and wrote a comment saying the hole was closed, which
# bought exactly nothing, because nothing here ever invoked server's vitest.
# Provisioning is necessary and it is not sufficient; this is the part that
# enforces.
SERVER_VITEST="$CA_TREE_TOP/server/node_modules/.bin/vitest"
if [ "$CA_TESTS_ON" = "1" ] && [ -f server/package.json ]; then
  SRV_TESTS=""
  SRV_SRC=""
  for f in $FILES; do
    [ -f "$f" ] || continue
    case "$f" in
      server/src/*.test.ts|server/src/**/*.test.ts)
        SRV_TESTS="$SRV_TESTS ${f#server/}" ;;
      server/src/*.ts|server/src/**/*.ts)
        case "$f" in
          *.d.ts) ;;
          *) SRV_SRC="$SRV_SRC ${f#server/}" ;;
        esac ;;
    esac
  done

  if [ -n "$SRV_TESTS$SRV_SRC" ]; then
    if [ ! -x "$SERVER_VITEST" ] && ca_same_repo; then
      ca_provision "$CA_ROOT_MAIN/server/node_modules" "$CA_TREE_TOP/server/node_modules" \
        && echo "[club-arena pre-push] provisioned server deps so the engine gate can run."
    fi
  fi

  if [ -n "$SRV_TESTS$SRV_SRC" ] && [ ! -x "$SERVER_VITEST" ]; then
    echo ""
    echo "[club-arena pre-push] REFUSING: you changed server/** and there is no vitest"
    echo "                      in server/, so the ENGINE gate cannot run. This is the"
    echo "                      code that deals real hands."
    echo "                      Fix:  (cd server && npm ci)"
    echo "                      Deliberate override: CA_SKIP_TESTS=1"
    echo ""
    FAIL=1
  elif [ -n "$SRV_TESTS" ]; then
    echo "[club-arena pre-push] running the server test files you changed..."
    if ! ( cd server && "$SERVER_VITEST" run $SRV_TESTS ); then
      echo ""
      echo "[club-arena pre-push] BLOCKED: a server test you changed is failing."
      echo "                      auto-deploy-hetzner.yml runs the server suite BEFORE"
      echo "                      it builds, so a red one here does not fail a report -"
      echo "                      it stops the engine deploying at all."
      FAIL=1
    fi
  fi

  if [ -n "$SRV_SRC" ] && [ -x "$SERVER_VITEST" ]; then
    echo "[club-arena pre-push] running the server tests that cover your changes..."
    if ! ( cd server && "$SERVER_VITEST" related --run $SRV_SRC ); then
      echo ""
      echo "[club-arena pre-push] BLOCKED: your engine change breaks a test that covers it."
      echo "                      If the test pins behaviour you deliberately replaced,"
      echo "                      UPDATE it in this same commit."
      FAIL=1
    fi
  fi
fi

if [ "$FAIL" -ne 0 ]; then
  echo ""
  echo "[club-arena pre-push] FAILED — fix the issues above or use --no-verify if certain."
  exit 1
fi

exit 0
