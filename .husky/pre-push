#!/usr/bin/env bash
# Club Arena pre-push hook — Phase 6 consolidation gate (2026-04-27)
#
# Blocks pushes that:
#   1. Contain merge-conflict markers (lesson from f490f61bf)
#   2. Introduce vercel.json crons (Open Claw exclusive policy)
#   3. Introduce client-side PIN-gate storage (Phase 3.6 server-side only)
#   4. Use raw supabase.auth.getUser() outside src/lib/authUtils.ts
#
# Bypass with `git push --no-verify` only in genuine emergencies.

set -e

REMOTE="$1"
URL="$2"
FAIL=0

# Get the range of commits being pushed
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  # Skip deletions
  if [ "$LOCAL_SHA" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  if [ "$REMOTE_SHA" = "0000000000000000000000000000000000000000" ]; then
    # New branch — check all commits up to current
    RANGE="$LOCAL_SHA"
    FILES=$(git diff --name-only "$LOCAL_SHA")
  else
    RANGE="$REMOTE_SHA..$LOCAL_SHA"
    FILES=$(git diff --name-only "$REMOTE_SHA" "$LOCAL_SHA")
  fi

  # 0. Repo-wide invariants. These normally run in CI as blocking checks, but
  #    branch protection is UNAVAILABLE on a private repo without GitHub Pro —
  #    making the repos private (correctly, after keys leaked into history) also
  #    silently disabled required status checks and rulesets. CI still runs and
  #    still goes red; nothing enforces it server-side any more. Running the two
  #    fast guards here is the only enforcement left. Both are ~100ms.
  if [ -f scripts/ci/check-allin-pointer-events.mjs ]; then
    if ! node scripts/ci/check-allin-pointer-events.mjs; then
      echo "[club-arena pre-push] BLOCKED: all-in action panel would lose pointer events"
      FAIL=1
    fi
  fi
  if [ -f scripts/ci/check-monitoring-drift.mjs ]; then
    if ! node scripts/ci/check-monitoring-drift.mjs; then
      echo "[club-arena pre-push] BLOCKED: monitoring wiring is broken"
      FAIL=1
    fi
  fi

  # 1. Merge conflict markers
  for f in $FILES; do
    if [ -f "$f" ]; then
      if grep -nE '^(<<<<<<< |>>>>>>> |={7,}$)' "$f" >/dev/null 2>&1; then
        echo "[club-arena pre-push] BLOCKED: $f contains a merge-conflict marker"
        FAIL=1
      fi
    fi
  done

  # 2. vercel.json crons (policy: Open Claw exclusive)
  for f in $FILES; do
    case "$f" in
      *vercel.json)
        if [ -f "$f" ] && grep -q '"crons"' "$f"; then
          echo "[club-arena pre-push] BLOCKED: $f introduces a Vercel crons block"
          echo "                      Use Open Claw → workers exclusively."
          FAIL=1
        fi
        ;;
    esac
  done

  # 3. Client-side PIN-gate storage (Phase 3.6 forbids reintroducing this)
  for f in $FILES; do
    if [ -f "$f" ]; then
      case "$f" in
        *src/lib/auth/*) continue ;;
      esac
      if grep -qE "localStorage\.(set|get)Item\(['\"](commanderAdminPin|admin_pin|club_admin_pin)" "$f" 2>/dev/null; then
        echo "[club-arena pre-push] BLOCKED: $f reintroduces client-side PIN storage"
        echo "                      Phase 3.6 moved PIN validation server-side."
        FAIL=1
      fi
    fi
  done

  # 4. Raw supabase.auth.getUser() outside the canonical auth module
  #
  # 2026-08-21: this rule was unenforceable as written. It told you to "use
  # validateBearer() from src/lib/auth", but `src/lib/auth/` has never existed
  # in this repo's history and `validateBearer` has never been defined
  # anywhere. Phase 6 Rule 4 named a migration target that was never built, so
  # the only way past this gate was --no-verify — which also switches off the
  # merge-conflict-marker check in the same hook, the one guard here that has
  # actually caught a production break (f490f61bf).
  #
  # The canonical module is src/lib/authUtils.ts, and the helper is
  # readLocalSession(): it parses the shared 'smarter-poker-auth' JWT, honours
  # expiry, and is already documented in-file as "the SINGLE canonical
  # implementation - all auth code should use this". The rule now names it.
  #
  # src/lib/supabase.ts is exempt on purpose: it is the SDK wrapper, and
  # somebody has to be allowed to call the SDK.
  #
  # Known remaining callers, not yet migrated (this gate only fires on files
  # you actually touch, so they are a to-do, not a wall):
  #   src/services/WalletService.ts        src/services/AvatarService.ts
  #   src/services/AgentService.ts         src/components/table/RealTimeResultPanel.tsx
  #   src/components/tournament/TournamentStartingTicker.tsx
  #   src/components/tournament/TournamentRankingCard.tsx
  for f in $FILES; do
    if [ -f "$f" ]; then
      case "$f" in
        *src/lib/authUtils*) continue ;;
        *src/lib/supabase.ts) continue ;;
        *node_modules/*) continue ;;
      esac
      if grep -qE 'supabase\.auth\.getUser\(\)' "$f" 2>/dev/null; then
        echo "[club-arena pre-push] BLOCKED: $f calls supabase.auth.getUser()"
        echo "                      use readLocalSession() from src/lib/authUtils instead."
        FAIL=1
      fi
    fi
  done
done

if [ "$FAIL" -ne 0 ]; then
  echo ""
  echo "[club-arena pre-push] FAILED — fix the issues above or use --no-verify if certain."
  exit 1
fi

exit 0
