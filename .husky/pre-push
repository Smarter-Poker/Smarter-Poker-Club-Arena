#!/usr/bin/env bash
# Club Arena pre-push hook — Phase 6 consolidation gate (2026-04-27)
#
# Blocks pushes that:
#   1. Contain merge-conflict markers (lesson from f490f61bf)
#   2. Introduce vercel.json crons (Open Claw exclusive policy)
#   3. Introduce client-side PIN-gate storage (Phase 3.6 server-side only)
#   4. Use raw supabase.auth.getUser() outside src/lib/authUtils.ts
#
# Bypass with `git push --no-verify` only in genuine emergencies.

set -e

REMOTE="$1"
URL="$2"
FAIL=0

# Get the range of commits being pushed
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  # Skip deletions
  if [ "$LOCAL_SHA" = "0000000000000000000000000000000000000000" ]; then
    continue
  fi

  if [ "$REMOTE_SHA" = "0000000000000000000000000000000000000000" ]; then
    # New branch — check all commits up to current
    RANGE="$LOCAL_SHA"
    FILES=$(git diff --name-only "$LOCAL_SHA")
  else
    RANGE="$REMOTE_SHA..$LOCAL_SHA"
    FILES=$(git diff --name-only "$REMOTE_SHA" "$LOCAL_SHA")
  fi

  # ═══════════════════════════════════════════════════════════════════════
  # 5. NON-FAST-FORWARD PUSH TO main — added 2026-08-21 after a real loss.
  #
  # WHAT HAPPENED: main was rewound to ada755ab3 and four commits that were
  # already built, synced and SERVING IN PRODUCTION were dropped from it:
  # 5d42741e4 (seat-as-reservation), d884f5fd2 (BBJ palette re-land),
  # ea6d53082 (throwables sizing) and e0f707a09 (the case-sensitivity CI
  # fix). Production was left running code that main no longer contained,
  # so the next sync would have quietly deleted four features. The round-8
  # changelog on main still described that work as shipped, which is how you
  # know it was an accident and not a revert — nobody writes a changelog for
  # work they meant to drop.
  #
  # WHY A HOOK AND NOT BRANCH PROTECTION: branch protection is unavailable on
  # a private repo without GitHub Pro (see the note under check 0). Server
  # side there is nothing left to refuse a force-push, so the last place it
  # can be caught is here, on the machine doing it.
  #
  # This is deliberately not a lint. Every other check in this file is about
  # the CONTENT of a push; this one is about whether the push DESTROYS
  # published history. Losing commits is the only failure here that cannot
  # be fixed forward by another commit.
  case "$REMOTE_REF" in
    refs/heads/main)
      if [ "$REMOTE_SHA" != "0000000000000000000000000000000000000000" ]; then
        # The remote tip must be reachable from what we are about to push.
        # If it is not, this push deletes commits that are already on main.
        if ! git cat-file -e "$REMOTE_SHA" 2>/dev/null; then
          git fetch -q "$REMOTE" "$REMOTE_SHA" 2>/dev/null || true
        fi
        if ! git cat-file -e "$REMOTE_SHA" 2>/dev/null; then
          echo "[club-arena pre-push] BLOCKED: cannot verify this push is fast-forward."
          echo "                      The current remote tip ($REMOTE_SHA) is not in"
          echo "                      this clone, so whether it drops commits is unknowable."
          echo "                      Run: git fetch $REMOTE main   then push again."
          FAIL=1
        elif ! git merge-base --is-ancestor "$REMOTE_SHA" "$LOCAL_SHA" 2>/dev/null; then
          DROPPED=$(git rev-list --count "$LOCAL_SHA..$REMOTE_SHA" 2>/dev/null || echo "?")
          echo ""
          echo "[club-arena pre-push] BLOCKED: this push REWINDS main."
          echo ""
          echo "  Remote main is at $REMOTE_SHA, which is NOT an ancestor of what you"
          echo "  are pushing. $DROPPED commit(s) currently on main would stop existing."
          echo ""
          echo "  Commits that would be dropped:"
          git log --oneline --max-count=15 "$LOCAL_SHA..$REMOTE_SHA" 2>/dev/null | sed 's/^/    /'
          echo ""
          echo "  This is how four production-serving commits were lost on 2026-08-21."
          echo "  Almost always the fix is to REBASE ONTO them rather than over them:"
          echo ""
          echo "      git pull --rebase $REMOTE main && git push"
          echo ""
          echo "  If you are deliberately reverting, revert with a commit - that keeps"
          echo "  the history and is reviewable. A rewind leaves no trace of what went."
          echo ""
          echo "  Genuine emergency override:  CA_ALLOW_MAIN_REWIND=1 git push ..."
          echo ""
          if [ "${CA_ALLOW_MAIN_REWIND:-0}" = "1" ]; then
            echo "  [CA_ALLOW_MAIN_REWIND=1 set - allowing this rewind]"
          else
            FAIL=1
          fi
        fi
      fi
      ;;
  esac

  # 0. Repo-wide invariants. These normally run in CI as blocking checks, but
  #    branch protection is UNAVAILABLE on a private repo without GitHub Pro —
  #    making the repos private (correctly, after keys leaked into history) also
  #    silently disabled required status checks and rulesets. CI still runs and
  #    still goes red; nothing enforces it server-side any more. Running the two
  #    fast guards here is the only enforcement left. Both are ~100ms.
  if [ -f scripts/ci/check-allin-pointer-events.mjs ]; then
    if ! node scripts/ci/check-allin-pointer-events.mjs; then
      echo "[club-arena pre-push] BLOCKED: all-in action panel would lose pointer events"
      FAIL=1
    fi
  fi
  if [ -f scripts/ci/check-monitoring-drift.mjs ]; then
    if ! node scripts/ci/check-monitoring-drift.mjs; then
      echo "[club-arena pre-push] BLOCKED: monitoring wiring is broken"
      FAIL=1
    fi
  fi

  # 1. Merge conflict markers
  for f in $FILES; do
    if [ -f "$f" ]; then
      if grep -nE '^(<<<<<<< |>>>>>>> |={7,}$)' "$f" >/dev/null 2>&1; then
        echo "[club-arena pre-push] BLOCKED: $f contains a merge-conflict marker"
        FAIL=1
      fi
    fi
  done

  # 2. vercel.json crons (policy: Open Claw exclusive)
  for f in $FILES; do
    case "$f" in
      *vercel.json)
        if [ -f "$f" ] && grep -q '"crons"' "$f"; then
          echo "[club-arena pre-push] BLOCKED: $f introduces a Vercel crons block"
          echo "                      Use Open Claw → workers exclusively."
          FAIL=1
        fi
        ;;
    esac
  done

  # 3. Client-side PIN-gate storage (Phase 3.6 forbids reintroducing this)
  for f in $FILES; do
    if [ -f "$f" ]; then
      case "$f" in
        *src/lib/auth/*) continue ;;
      esac
      if grep -qE "localStorage\.(set|get)Item\(['\"](commanderAdminPin|admin_pin|club_admin_pin)" "$f" 2>/dev/null; then
        echo "[club-arena pre-push] BLOCKED: $f reintroduces client-side PIN storage"
        echo "                      Phase 3.6 moved PIN validation server-side."
        FAIL=1
      fi
    fi
  done

  # 4. Raw supabase.auth.getUser() outside the canonical auth module
  #
  # 2026-08-21: this rule was unenforceable as written. It told you to "use
  # validateBearer() from src/lib/auth", but `src/lib/auth/` has never existed
  # in this repo's history and `validateBearer` has never been defined
  # anywhere. Phase 6 Rule 4 named a migration target that was never built, so
  # the only way past this gate was --no-verify — which also switches off the
  # merge-conflict-marker check in the same hook, the one guard here that has
  # actually caught a production break (f490f61bf).
  #
  # The canonical module is src/lib/authUtils.ts, and the helper is
  # readLocalSession(): it parses the shared 'smarter-poker-auth' JWT, honours
  # expiry, and is already documented in-file as "the SINGLE canonical
  # implementation - all auth code should use this". The rule now names it.
  #
  # src/lib/supabase.ts is exempt on purpose: it is the SDK wrapper, and
  # somebody has to be allowed to call the SDK.
  #
  # Known remaining callers, not yet migrated (this gate only fires on files
  # you actually touch, so they are a to-do, not a wall):
  #   src/services/WalletService.ts        src/services/AvatarService.ts
  #   src/services/AgentService.ts         src/components/table/RealTimeResultPanel.tsx
  #   src/components/tournament/TournamentStartingTicker.tsx
  #   src/components/tournament/TournamentRankingCard.tsx
  for f in $FILES; do
    if [ -f "$f" ]; then
      case "$f" in
        *src/lib/authUtils*) continue ;;
        *src/lib/supabase.ts) continue ;;
          *node_modules/*) continue ;;
        *.husky/*) continue ;;
        # 2026-08-21: this gate is about CODE calling the raw auth API. It was
        # matching prose too, so MIGRATION-CHANGELOG.md — which QUOTES the
        # pattern in an audit entry from 2026 — blocked every push that
        # touched the changelog. Docs and data cannot call anything.
        *.md|*.markdown|*.txt|*.json|*.sql|*.lock) continue ;;
      esac
      if grep -qE 'supabase\.auth\.getUser\(\)' "$f" 2>/dev/null; then
        echo "[club-arena pre-push] BLOCKED: $f calls supabase.auth.getUser()"
        echo "                      use readLocalSession() from src/lib/authUtils instead."
        FAIL=1
      fi
    fi
  done
done

# ─────────────────────────────────────────────────────────────────────────────
# HOUSE TEXT RULES (Dan 2026-08-21)
#
#   "First letter of every word is capitalized, that's a hard rule for all
#    forward facing pages", and em dashes are forbidden.
#
# Both had a checker already, but it only ran in ci.yml - the workflow this
# repo's own notes say NEVER COMPLETES on main, because pushes land faster than
# its ~6 minutes and cancel-in-progress kills every run. A gate that never
# finishes is not a gate, so they run here, where the other house rules live.
# Together they take about two seconds.
#
# Autofix:  node scripts/ci/check-title-case.mjs --fix
#           node scripts/ci/check-ui-text.mjs --fix
# ─────────────────────────────────────────────────────────────────────────────
if [ -f scripts/ci/check-title-case.mjs ]; then
  if ! node scripts/ci/check-title-case.mjs; then
    FAIL=1
  fi
fi

if [ -f scripts/ci/check-ui-text.mjs ]; then
  if ! node scripts/ci/check-ui-text.mjs; then
    FAIL=1
  fi
fi

# ═════════════════════════════════════════════════════════════════════════════
# 10. THE TEST SUITE — THE ONE GATE THAT WAS MISSING (Dan, 2026-08-21)
#
# On 2026-08-21 main sat unable to deploy FOUR separate times, every one of
# them a red test pushed alongside the feature it was meant to guard:
#
#   - tests/tip-dealer-guards.test.tsx imported a component deleted the day
#     before, so it failed at transform time from the moment it landed.
#   - tests/unit/handCompletionLaw.test.ts read src/services/soundService.ts.
#     The file is SoundService.ts. macOS resolved it; Linux CI did not.
#   - tests/unit/winningCardHighlight.test.ts asserted that the engine sends
#     card_indices. The engine has never contained that string. It was a
#     specification committed with no implementation beside it - by a commit
#     whose own message was "unblock the deploy gate".
#   - tests/actionpanel-raise-presets.test.ts still asserted the rounding rule
#     that the same commit's feature had just replaced.
#
# Each one blocked EVERY agent and every deploy until a human noticed, because
# `npx vitest run tests/` in build-for-world-hub.yml is what publishes the
# bundle. This hook already enforces nine house rules about the CONTENT of a
# push and never once ran the tests.
#
# WHY TARGETED AND NOT THE WHOLE SUITE: the full run is minutes; `vitest
# related` on the files you actually touched is about four seconds, and it
# would have caught all four incidents above - three of them changed a test
# file (run directly), the fourth changed ActionPanel.tsx (found by related).
# A gate people wait minutes for is a gate people start bypassing.
#
# Emergency bypass:  CA_SKIP_TESTS=1 git push
# ═════════════════════════════════════════════════════════════════════════════
if [ -z "${CA_SKIP_TESTS:-}" ] && [ -f package.json ]; then
  CHANGED_TESTS=""
  CHANGED_SRC=""
  for f in $FILES; do
    [ -f "$f" ] || continue
    case "$f" in
      tests/*.test.ts|tests/*.test.tsx|tests/**/*.test.ts|tests/**/*.test.tsx)
        CHANGED_TESTS="$CHANGED_TESTS $f" ;;
      src/*.ts|src/*.tsx|server/src/*.ts|src/**/*.ts|src/**/*.tsx|server/src/**/*.ts)
        case "$f" in
          *.test.ts|*.test.tsx|*.d.ts) ;;
          *) CHANGED_SRC="$CHANGED_SRC $f" ;;
        esac ;;
    esac
  done

  if [ -n "$CHANGED_TESTS" ]; then
    echo "[club-arena pre-push] running the test files you changed..."
    if ! npx vitest run $CHANGED_TESTS; then
      echo ""
      echo "[club-arena pre-push] BLOCKED: a test you changed is failing."
      echo "                      A red test on main stops the World Hub bundle"
      echo "                      for EVERY agent, not just for you."
      echo ""
      echo "                      Writing the spec before the code is fine - but"
      echo "                      mark it it.skip() or describe.skip() until the"
      echo "                      implementation lands, so it documents the work"
      echo "                      without holding the deploy hostage."
      FAIL=1
    fi
  fi

  if [ -n "$CHANGED_SRC" ]; then
    echo "[club-arena pre-push] running the tests that cover your changes..."
    if ! npx vitest related --run $CHANGED_SRC; then
      echo ""
      echo "[club-arena pre-push] BLOCKED: your change breaks a test that covers it."
      echo "                      If the test pins behaviour you deliberately"
      echo "                      replaced, UPDATE the test in this same commit."
      echo "                      Leaving it red blocks every deploy until"
      echo "                      somebody else finds it."
      FAIL=1
    fi
  fi
fi

if [ "$FAIL" -ne 0 ]; then
  echo ""
  echo "[club-arena pre-push] FAILED — fix the issues above or use --no-verify if certain."
  exit 1
fi

exit 0
