#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════════
#  pre-rebase — never replay local commits onto the shared, moving main
# ═══════════════════════════════════════════════════════════════════════════════
#
# Dan 2026-08-21: "how do you fix this and prevent that from happening anymore?"
#
# THE FAILURE THIS PREVENTS
# On 2026-08-21 the Mac clone sat stranded at step 1 of a 10-commit rebase with
# conflict markers in 12+ files. It was not a one-off: that clone's reflog holds
# 54 local commits, 40 `pull --rebase origin main`, and 10 emergency
# `reset --hard origin/main` rescues.
#
# WHY IT HAPPENS HERE AND NOT IN A NORMAL REPO
# Several agents ship to this repo at once, and they do NOT all push the local
# commit object: the GitHub-MCP path re-creates the same CONTENT as a different
# SHA. So the Mac ends up holding commits whose work is already upstream under
# another id. `git pull --rebase` then replays each one onto a branch that
# already contains its changes - every hunk conflicts, and origin/main has moved
# again by the time anyone looks. Git's own duplicate detection cannot save it
# (the rebase state even carries a `drop_redundant_commits` marker).
#
# THE RULE
# A rebase of main that would REPLAY commits is refused. Two things are still
# allowed, because neither can strand:
#   - a fast-forward (nothing to replay) - the normal way to sync;
#   - any feature branch - rebase those all you like.
# There is no environment-variable bypass. Published history is recovered by a
# reviewed forward commit or merge, never by replaying or rewriting `main`.

upstream="${1:-}"
branch="${2:-}"
[ -n "$branch" ] || branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo '')"

# Only the shared branch is guarded.
[ "$branch" = "main" ] || exit 0

# Count what would be replayed. Unknown ancestry fails closed because rebasing
# shared production history is never a safe fallback.
if ! ahead="$(git rev-list --count "${upstream}..${branch}" 2>/dev/null)"; then
  echo "[club-arena pre-rebase] BLOCKED: cannot prove that rebasing main replays zero commits." >&2
  echo "[club-arena pre-rebase] Fetch the upstream branch, then fast-forward or merge through a reviewed branch." >&2
  exit 1
fi
case "$ahead" in
  ''|*[!0-9]*)
    echo "[club-arena pre-rebase] BLOCKED: invalid ancestry result while guarding main." >&2
    exit 1
    ;;
  0) exit 0 ;;   # fast-forward: nothing to replay, nothing to strand
esac

cat >&2 <<MSG

  ┌──────────────────────────────────────────────────────────────────────┐
  │  REBASE OF main REFUSED - this is the guard, not a git error         │
  └──────────────────────────────────────────────────────────────────────┘

  It would replay ${ahead} local commit(s) onto ${upstream}.

  On this repo that is how clones get stranded: several agents ship at once
  and some push the same WORK as a different SHA, so your local commits are
  usually already upstream under another id. Replaying them conflicts in
  every file they touch, and main moves again while you are resolving it.

  Preserve any local commits on a feature branch, fetch origin/main, merge the
  current main into that feature branch, and ship it through a reviewed PR.
  There is no direct-main or environment-variable bypass.

MSG
exit 1
