# P12.2 identity check. The same scripts were run from a git archive of server/ at the base commit 1157cf08 (node_modules shared) and from this branch's working tree, EQUITY_GOVERNOR=off, one process at a time.

## 1. PLO4 (Phase 10) and Phase 11 outputs are byte-identical (hash = sha256, first 16 hex, of the JSON output with durationMs zeroed)

Script:

    process.env.EQUITY_GOVERNOR = 'off';
    process.env.SUPABASE_URL = 'https://supabase.invalid';
    process.env.SUPABASE_SERVICE_ROLE_KEY = 'x';
    import { createHash } from 'node:crypto';
    const root = process.cwd();
    const P = await import(root + '/src/benchmark/Plo4PolicyLeague.ts');
    const O = await import(root + '/src/benchmark/OmahaVariantStrengthLeague.ts');
    const OL = await import(root + '/src/benchmark/OmahaVariantPolicyLeague.ts');
    const { channelHub } = await import(root + '/src/hub/ChannelHub.ts');
    const h = (x: unknown) => createHash('sha256').update(JSON.stringify(x, (k, v) => (k === 'durationMs' ? 0 : v))).digest('hex').slice(0, 16);
    for (const id of ['p10c-6max-2dealt-100bb', 'p10c-6max-100bb']) console.log('plo4 shard', id, h(await P.runPlo4StrengthShard({ profileId: id, seed: 10101101, shard: 0, mode: 'development', pairs: 36 })));
    for (const v of ['plo5', 'plo6', 'plo8']) console.log('p11 shard', v, h(await O.runOmahaVariantStrengthShard(v, { profileId: `p11c-${v}-6max-100bb`, seed: 11101101, shard: 0, mode: 'development', pairs: 36 })));
    for (const id of ['heads-up-25bb', 'six-max-100bb']) console.log('plo4 league', id, h(await P.runPlo4PolicyLeague({ profileId: id, pairs: 4, seed: 10101101 })));
    for (const id of ['plo5-hu-25bb', 'plo8-hu-25bb']) console.log('p11 league', id, h(await OL.runOmahaVariantLeague({ profileId: id, pairs: 4, seed: 11101101 })));
    channelHub.close(); process.exit(0);

