## 2. Phase 12 development league: off and shadow identical; candidate differs only where the new guard refused a proposal

Hash excludes the new per-hand illegalCandidates counter. Script:

    process.env.EQUITY_GOVERNOR = 'off';
    process.env.SUPABASE_URL = 'https://supabase.invalid';
    process.env.SUPABASE_SERVICE_ROLE_KEY = 'x';
    import { createHash } from 'node:crypto';
    const root = process.cwd();
    const R = await import(root + '/src/benchmark/RemainingVariantPolicyLeague.ts');
    const { channelHub } = await import(root + '/src/hub/ChannelHub.ts');
    const strip = (x: any) => JSON.parse(JSON.stringify(x, (k, v) => (k === 'illegalCandidates' ? undefined : v)));
    const h = (x: unknown) => createHash('sha256').update(JSON.stringify(x)).digest('hex').slice(0, 16);
    for (const v of ['short_deck', 'pineapple', 'flh', 'flo8'])
      for (const p of ['hu-25bb', 'cash-cap-100bb']) {
        for (const mode of ['off', 'shadow', 'candidate']) {
          const r = await R.runRemainingVariantLeague({ profileId: `${v}-${p}`, pairs: 8, seed: 12101101, mode });
          const ic = r.pairs.reduce((n: number, q: any) => n + (q.candidate.illegalCandidates ?? 0), 0);
          console.log(v, p, mode, 'hash-without-counter', h(strip(r)), 'illegalCandidates', ic, 'changed', r.changed);
        }
      }
    channelHub.close(); process.exit(0);

