# Schema-only example. Do not copy workstation credentials into this file and
# do not deploy the monitoring stack by hand. The reviewed Club Arena
# `deploy-club-arena-monitoring` workflow owns delivery to Hetzner; host runtime
# secrets are provisioned out of band and never committed.

# Grafana UI admin password (used on first boot to seed the admin user)
GRAFANA_ADMIN_PASSWORD=<provision-on-hetzner-host>

# AlertManager routing destinations
SLACK_ALERT_URL=<provision-on-hetzner-host>
PAGERDUTY_SERVICE_KEY=<provision-on-hetzner-host>
