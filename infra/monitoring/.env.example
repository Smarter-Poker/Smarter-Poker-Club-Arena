# Copy to .env on cron-01 and fill in before `docker compose up -d`.

# Grafana UI admin password (used on first boot to seed the admin user)
GRAFANA_ADMIN_PASSWORD=CHANGE-ME-TO-A-LONG-RANDOM-STRING

# AlertManager routing destinations
SLACK_ALERT_URL=https://hooks.slack.com/services/AAA/BBB/CCC
PAGERDUTY_SERVICE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
