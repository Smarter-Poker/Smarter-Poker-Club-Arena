{
  "annotations": { "list": [] },
  "editable": true,
  "id": null,
  "panels": [
    {
      "id": 1,
      "title": "Cron lag (seconds since last run)",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "time() - cron_last_run_timestamp",
          "legendFormat": "{{ job_name }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 600 },
              { "color": "red", "value": 900 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Cron failure rate",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 10 },
      "targets": [
        {
          "expr": "rate(cron_runs_failed_total[30m]) / rate(cron_runs_total[30m])",
          "legendFormat": "{{ job_name }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["smarter-poker", "cron"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "title": "Cron Job Health",
  "uid": "smarter-poker-cron",
  "version": 1
}
