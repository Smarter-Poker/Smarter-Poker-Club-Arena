<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Club Arena</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Permission strings (2026-09-09). iOS terminates an app that asks for
	     a protected resource without the matching string. Voice chat at the
	     table calls getUserMedia (src/services/VoiceSignalService.ts); the
	     club-logo and avatar pickers are <input type="file"> and may open the
	     camera. Apple reads these at review, so they say what the feature is. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Club Arena Uses The Microphone For Voice Chat At The Table When You Turn It On.</string>
	<key>NSCameraUsageDescription</key>
	<string>Club Arena Uses The Camera When You Choose To Take A Photo For Your Avatar Or Club Logo.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Club Arena Opens Your Photo Library When You Choose A Picture For Your Avatar Or Club Logo.</string>
	<!-- Apple's privacy manifest for the app target lives beside this file
	     (PrivacyInfo.xcprivacy); the entitlements (push, associated domains)
	     in App.entitlements. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Deep links (2026-09-07): clubarena://... opens the app with no store
	     account needed. Universal links (https://smarter.poker/hub/club-arena/...)
	     are the Associated Domains entitlement (App.entitlements) plus the
	     apple-app-site-association the World Hub serves once APPLE_TEAM_ID is
	     set on Vercel. Handled by src/lib/native/deepLinks.ts. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>poker.smarter.clubarena</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>clubarena</string>
			</array>
		</dict>
	</array>
	<!-- The lobby, the felt and every sheet are designed portrait-first
	     (CLAUDE.md 10.6: mobile-first, 375px). A phone is locked to portrait
	     by the OS rather than by the CSS overlay in PortraitLock.tsx; iPad
	     keeps rotation below. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
    <false/>
    <key>UISceneConfigurations</key>
    <dict>
      <key>UIWindowSceneSessionRoleApplication</key>
      <array>
        <dict>
            <key>UISceneConfigurationName</key>
            <string>Default Configuration</string>
            <key>UISceneDelegateClassName</key>
            <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
            <key>UISceneStoryboardFile</key>
            <string>Main</string>
        </dict>
      </array>
    </dict>
	</dict>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>
