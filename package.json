{
  "name": "@smarter-poker/club-arena",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/dev-freshness-check.mjs",
    "dev": "vite",
    "build": "tsc -b && node scripts/generate-webp-media.mjs && node scripts/generate-customization-thumbnails.mjs && vite build && node scripts/self-host-fonts.mjs && node scripts/optimize-dist-media.mjs && node scripts/stamp-build-provenance.mjs && node -e \"require('fs').copyFileSync('tests/protected-features.json','dist/protected-features.json')\"",
    "preview": "vite preview",
    "analyze": "vite build --mode production && npx vite-bundle-visualizer",
    "assets:customization-thumbnails": "node scripts/generate-customization-thumbnails.mjs --force",
    "lint": "eslint src/",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "precommit": "lint-staged",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:customization": "playwright test --config=playwright.customization.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:performance": "node scripts/ci/route-performance.mjs",
    "migrate": "node scripts/migrate.js",
    "migrate:all": "node scripts/migrate.js --all",
    "types:generate": "npx supabase gen types typescript --project-id kuklfnapbkmacvwxktbh --schema public > src/types/supabase.ts",
    "db:push": "node scripts/orb-sql-deploy.cjs",
    "prepare": "git config core.hooksPath .husky || true",
    "check:title-case": "node scripts/ci/check-title-case.mjs",
    "check:painted-text": "node scripts/ci/check-painted-text-case.mjs",
    "fix:painted-text": "node scripts/ci/check-painted-text-case.mjs --fix",
    "fix:title-case": "node scripts/ci/check-title-case.mjs --fix",
    "check:club-entry-budgets": "node scripts/check-club-entry-budgets.mjs"
  },
  "dependencies": {
    "@rive-app/canvas": "^2.40.1",
    "@sentry/react": "^10.38.0",
    "@supabase/supabase-js": "^2.49.0",
    "@types/md5": "^2.3.6",
    "canvas-confetti": "^1.9.4",
    "fast-json-patch": "^3.1.1",
    "framer-motion": "^11.18.0",
    "gsap": "^3.15.0",
    "md5": "^2.3.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "7.18.3",
    "react-virtuoso": "^4.18.12",
    "recharts": "^3.7.0",
    "three": "^0.172.0",
    "web-vitals": "^5.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.58.0",
    "@sentry/vite-plugin": "4.8.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "happy-dom": "^20.11.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "pg": "^8.20.0",
    "prettier": "^3.8.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.7",
    "vite-bundle-visualizer": "^1.0.0",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix"
    ],
    "tests/**/*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,css,json,md}": [
      "prettier --write"
    ]
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.60.0"
  }
}
