  "constraints": [
    {
      "name": "union_pnl_cash_outcome_link_resoluti_outcome_evidence_md5_check",
      "definition": "CHECK ((outcome_evidence_md5 ~ '^[0-9a-f]{32}$'::text))",
      "validated": true
    },
    {
      "name": "union_pnl_cash_outcome_link_resolutions_check",
      "definition": "CHECK ((proof_md5 = md5((proof)::text)))",
      "validated": true
    },
    {
      "name": "union_pnl_cash_outcome_link_resolutions_check1",
      "definition": "CHECK (((roster_source = 'manifest'::text) = (manifest_id IS NOT NULL)))",
      "validated": true
    },
    {
      "name": "union_pnl_cash_outcome_link_resolutions_check2",
      "definition": "CHECK ((((proof ->> 'status'::text) = 'proven'::text) AND ((proof ->> 'resolution_kind'::text) = 'cash_outcome_provenance_link'::text) AND ((proof ->> 'table_id'::text) = (table_id)::text) AND (((proof ->> 'hand_number'::text))::bigint = hand_number) AND ((proof ->> 'hand_id'::text) = (hand_id)::text) AND ((proof ->> 'outcome_payload_hash'::text) = outcome_payload_hash) AND ((proof ->> 'outcome_evidence_md5'::text) = outcome_evidence_md5) AND ((proof ->> 'roster_source'::text) = roster_source) AND (NOT ((proof ->> 'manifest_id'::text) IS DISTINCT FROM (manifest_id)::text)) AND ((proof -> 'game_scope'::text) = game_scope) AND ((proof -> 'evidence'::text) = evidence) AND ((evidence -> 'game_scope'::text) = game_scope)))",
      "validated": true
    },
    {
      "name": "union_pnl_cash_outcome_link_resolutions_evidence_check",
      "definition": "CHECK (((jsonb_typeof(evidence) = 'object'::text) AND ((evidence ->> 'provenance_link'::text) = 'resolved'::text)))",
      "validated": true
    },
    {
      "name": "union_pnl_cash_outcome_link_resolutions_game_scope_check",
      "definition": "CHECK (((jsonb_typeof(game_scope) = 'object'::text) AND (game_scope ?& ARRAY['game_union_id'::text, 'host_club_id'::text, 'tournament_id'::text, 'is_private'::text, 'asset'::text, 'unit_scale'::text])))",
      "validated": true
    },
    {
      "name": "union_pnl_cash_outcome_link_resolutions_hand_id_key",
      "definition": "UNIQUE (hand_id)",
      "validated": true
    },
    {
      "name": "union_pnl_cash_outcome_link_resolutions_pkey",
      "definition": "PRIMARY KEY (table_id, hand_number)",
      "validated": true
    },
    {
      "name": "union_pnl_cash_outcome_link_resolutions_reason_check",
      "definition": "CHECK ((length(btrim(reason)) >= 20))",
      "validated": true
    },
    {
      "name": "union_pnl_cash_outcome_link_resolutions_roster_source_check",
      "definition": "CHECK ((roster_source = ANY (ARRAY['manifest'::text, 'seat_inventory'::text, 'lightning_pool'::text])))",
      "validated": true
    }
  ],
