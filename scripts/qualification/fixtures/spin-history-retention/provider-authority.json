      "signature": "fn_tournament_cancellation_receipts_append_only()",
      "definition": "CREATE OR REPLACE FUNCTION public.fn_tournament_cancellation_receipts_append_only()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'public'\nAS $function$\nBEGIN\n  RAISE EXCEPTION\n    'tournament cancellation receipt is immutable; % refused for tournament %',\n    TG_OP, OLD.tournament_id USING ERRCODE = '55000';\nEND;\n$function$\n",
