      "signature": "trg_finish_hand_post_commit_obligations()",
      "definition": "CREATE OR REPLACE FUNCTION public.trg_finish_hand_post_commit_obligations()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_temp'\nAS $function$\nDECLARE\n  v_result jsonb;\nBEGIN\n  v_result := public.fn_ca_process_hand_post_commit_obligations(OLD.hand_id);\n  IF COALESCE((v_result->>'ok')::boolean, false) IS NOT TRUE\n     AND v_result->>'reason' <> 'legacy_no_obligations' THEN\n    RAISE EXCEPTION 'hand post-commit obligations remain pending for %: %',\n      OLD.hand_id, v_result;\n  END IF;\n  RETURN OLD;\nEND;\n$function$\n",
