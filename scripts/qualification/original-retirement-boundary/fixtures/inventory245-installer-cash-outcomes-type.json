{
  "query": "SELECT a.attname column_name,format_type(a.atttypid,a.atttypmod) data_type,a.attnotnull not_null FROM pg_attribute a WHERE a.attrelid='public.union_pnl_cash_outcomes'::regclass AND a.attnum>0 AND NOT a.attisdropped ORDER BY a.attnum;",
  "rows": [
    { "column_name": "table_id", "data_type": "uuid", "not_null": true },
    { "column_name": "hand_number", "data_type": "bigint", "not_null": true },
    { "column_name": "hand_id", "data_type": "uuid", "not_null": true },
    { "column_name": "transaction_id", "data_type": "xid8", "not_null": true },
    { "column_name": "recognized_at", "data_type": "timestamp with time zone", "not_null": true },
    { "column_name": "payload_hash", "data_type": "text", "not_null": true },
    { "column_name": "game_scope", "data_type": "jsonb", "not_null": true },
    { "column_name": "evidence", "data_type": "jsonb", "not_null": true }
  ]
}
