# Supabase Configuration
SUPABASE_URL=https://kuklfnapbkmacvwxktbh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# Server
PORT=8080
NODE_ENV=production

# Internal API key — World Hub → Hetzner engine (server-to-server auth)
# Phase U4 (2026-05-18): Required by ChannelWebSocketServer for trusted API calls.
# Generate with: openssl rand -hex 32
# Must match INTERNAL_API_KEY in Vercel env vars for hub-vanguard.
INTERNAL_API_KEY=your_internal_api_key_here

# Hand projection wake over LISTEN/NOTIFY (2026-09-10).
# Must be the Supavisor SESSION-mode pooler string (port 5432 on the
# aws-N-<region>.pooler.supabase.com host, Dashboard > Connect > Session pooler),
# NOT the transaction pooler on 6543 - LISTEN is session-level. Unset =
# listener disabled (warns once); the 5 s poll and local commit wakes still run.
ENGINE_PG_LISTEN_URL=
# Optional CA bundle path if the pooler chain is not publicly trusted
# (Dashboard > Database > SSL > prod-ca-2021.crt). Leave empty to use the
# system trust store.
ENGINE_PG_LISTEN_CA_FILE=
# Safety-poll interval for the projection worker (ms). Default 5000; an empty
# or non-numeric value means the default, and it is clamped to 250..60000.
# While ENGINE_PG_LISTEN_URL is unset this poll is the only cross-process wake.
HAND_PROJECTION_POLL_MS=5000
# Per-table chains the outbox drain projects at once. Default 4, clamped to
# 1..16. The database serialises each table with advisory locks; this is the
# number of tables in flight, never the number of hands at one table.
HAND_PROJECTION_DRAIN_CONCURRENCY=4
# How often the outbox depth / oldest-row gauges are sampled (ms). Default
# 60000, clamped to 5000..600000. One count(*) + one indexed row per sample.
HAND_PROJECTION_OUTBOX_SAMPLE_MS=60000
