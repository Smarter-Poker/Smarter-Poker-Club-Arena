# Supabase Configuration
SUPABASE_URL=https://kuklfnapbkmacvwxktbh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# Server
PORT=8080
NODE_ENV=production

# Internal API key — World Hub → Hetzner engine (server-to-server auth)
# Phase U4 (2026-05-18): Required by ChannelWebSocketServer for trusted API calls.
# Generate with: openssl rand -hex 32
# Must match INTERNAL_API_KEY in Vercel env vars for hub-vanguard.
INTERNAL_API_KEY=your_internal_api_key_here

# Sentry (Phase 5.1.1a — game-server error tracking)
# Get DSN from https://sentry.io → Project: smarter-poker-game-engine → Settings → Client Keys.
# If unset, initSentry() prints a warning and falls through to console-only logging.
SENTRY_DSN=
