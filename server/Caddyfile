{
    # The engine accepts WebSocket bearer authentication through this protocol
    # header because browsers cannot set Authorization during the upgrade. Caddy
    # includes request headers in upstream error logs, so an EOF/502 used to
    # persist that credential verbatim. Remove the field from every runtime log
    # encoder without changing the proxy or WebSocket route.
    log {
        format filter {
            request>headers>Sec-Websocket-Protocol delete
        }
    }
}

engine.smarter.poker {
    reverse_proxy localhost:8080
    # Compress the engine's HTTP responses (/health, /actions, lobby JSON).
    # WebSocket frames are untouched: Caddy never encodes an upgraded
    # connection. The static origin has carried `encode zstd gzip` since it
    # went up; the engine host never did (performance checklist audit,
    # 2026-09-17). The live /etc/caddy/Caddyfile on engine-01 is operator
    # managed host state, so this line reaches production only when the
    # operator adds it there and runs `caddy reload`.
    encode zstd gzip


    header {
        Access-Control-Allow-Origin *
        Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        Access-Control-Allow-Headers "Content-Type, Authorization"
    }

    @options method OPTIONS
    respond @options 204
}
