protocol=club-arena-engine-image-request-v2
scope=immutable-request-codec-only
encoding=canonical-sorted-compact-json-with-one-final-newline
maximum-request-bytes=16384
run-key=github-run-id-github-run-attempt
intake-fields=protocol,kind,run_key,run_url,actor,not_after_epoch,source_sha,control_sha,image_authority,host_import_qualified,deployment_authorized
release-additional-fields=generation_path,intake_sha256
image-authority-fields=expected,custody_receipt,custody_receipt_sha256
expected-fields=identity,archive_sha256,archive_bytes,descriptor_sha256,artifact_id,artifact_digest
identity-fields=repository,workflow,workflow_control_sha,source_sha,server_tree,run_id,run_attempt,image_id
custody-receipt-fields=scope,status,producer_job_id,artifact_id,identity,archive_sha256,archive_bytes,descriptor_sha256,host_import_qualified,deployment_authorized
custody-scope=same-run-engine-image-admission
production-workflow=.github/workflows/auto-deploy-hetzner.yml
production-event=repository_dispatch
artifact-digest=github-artifact-zip-sha256-distinct-from-raw-image-archive-sha256
release-intake-binding=sha256-of-exact-canonical-parent-intake-bytes
release-intent-contract=byte-identical-to-release-request
recovery-contract=read-exact-expired-request-without-renewal-or-new-mutation-authority
prepared-suffix=.prepared-v2
prepared-contract=fsynced-mode-0600-under-private-owned-directory-never-a-unit-trigger
host-import-qualified=false
deployment-authorized=false
v1-contract=unchanged-frozen-v1-units-and-generations-own-v1-recovery-no-conversion
