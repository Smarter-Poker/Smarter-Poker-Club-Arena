        "action": {
          "type": "string"
        },
        "minChips": {
          "$ref": "#/$defs/nonNegativeNullableNumber"
        },
        "maxChips": {
          "$ref": "#/$defs/nonNegativeNullableNumber"
        },
        "exactChips": {
          "$ref": "#/$defs/nonNegativeNullableNumber"
        },
        "allIn": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
