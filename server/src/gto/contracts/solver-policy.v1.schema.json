          }
        },
        "blinds": {
          "$ref": "#/$defs/blindState"
        },
        "rake": {
          "$ref": "#/$defs/rake"
        },
        "tournamentUtility": {
          "$ref": "#/$defs/tournamentUtility"
        },
        "payouts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/money"
          }
        },
        "bounties": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/money"
          }
        },
        "street": {
          "enum": [
            "preflop",
            "flop",
            "turn",
            "river"
