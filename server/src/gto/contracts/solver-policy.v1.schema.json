          "type": "number",
          "minimum": 0
        },
        "straddles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "seat",
              "amount"
            ],
            "properties": {
              "seat": {
                "type": "integer",
                "minimum": 0
              },
              "amount": {
                "$ref": "#/$defs/nonNegativeNullableNumber"
              }
            },
            "additionalProperties": false
          }
        },
        "complete": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "rake": {
      "type": "object",
      "required": [
        "percent",
        "capChips",
        "capBb",
        "noFlopNoDrop",
        "complete"
      ],
      "properties": {
        "percent": {
          "$ref": "#/$defs/nonNegativeNullableNumber"
        },
        "capChips": {
          "$ref": "#/$defs/nonNegativeNullableNumber"
        },
        "capBb": {
          "$ref": "#/$defs/nonNegativeNullableNumber"
        },
        "noFlopNoDrop": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "tournamentUtility": {
      "type": "object",
      "required": [
        "mode",
        "model",
        "playersRemaining",
        "entrants",
        "handForHand",
        "complete"
      ],
      "properties": {
