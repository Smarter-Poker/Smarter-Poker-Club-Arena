{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smarter.poker/contracts/solver-policy/solver-policy.v1.schema.json",
  "title": "Smarter Poker Solver Policy V1",
  "description": "Cross-repository contract for one complete poker decision and its policy answer.",
  "type": "object",
  "required": [
    "contractVersion",
    "policyVersion",
    "key",
    "kind",
    "node",
    "actions",
    "distribution",
    "legalSizes",
    "chipEv",
    "tournamentUtilityEv",
    "sourceArtifact",
    "qualitySeal",
    "validDomain",
    "confidence",
    "fallbackReason",
    "rangeDistribution"
  ],
  "properties": {
    "contractVersion": {
      "const": "smarter-poker.solver-policy.v1"
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "$ref": "#/$defs/policyKind"
    },
    "key": {
      "$ref": "#/$defs/decisionKey"
    },
    "node": {
      "$ref": "#/$defs/node"
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "legalSizes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/legalSize"
      }
    },
    "chipEv": {
      "$ref": "#/$defs/evEnvelope"
    },
    "tournamentUtilityEv": {
      "$ref": "#/$defs/utilityEvEnvelope"
    },
    "sourceArtifact": {
      "$ref": "#/$defs/sourceArtifact"
    },
    "qualitySeal": {
      "$ref": "#/$defs/qualitySeal"
    },
    "validDomain": {
      "$ref": "#/$defs/validDomain"
    },
    "confidence": {
      "$ref": "#/$defs/confidence"
    },
    "fallbackReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "rangeDistribution": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "exact"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "qualitySeal": {
            "const": "SOLVER_EXACT"
          },
          "sourceArtifact": {
            "properties": {
              "system": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!.*[vV]1(?:[^0-9]|$)).+$"
              },
              "artifactId": {
                "type": "string",
                "minLength": 1
              },
              "scenarioHash": {
                "type": "string",
                "minLength": 1
              },
              "solverVersion": {
                "type": "string",
                "minLength": 1
              },
              "solverBinaryChecksum": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              },
              "machineId": {
                "type": "string",
                "minLength": 1
              },
              "pipelineCommit": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{40}$"
              },
              "manifestVersion": {
                "type": "string",
                "minLength": 1
              },
              "manifestChecksum": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              },
              "sourceArtifactChecksum": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              },
              "qualityStatus": {
                "const": "validated"
              },
              "auditedAt": {
                "type": "string",
                "format": "date-time"
              },
              "provenanceComplete": {
                "const": true
              }
            },
            "required": [
              "system",
              "artifactId",
              "scenarioHash",
              "solverVersion",
              "solverBinaryChecksum",
              "machineId",
              "pipelineCommit",
              "manifestVersion",
              "manifestChecksum",
              "sourceArtifactChecksum",
              "qualityStatus",
              "auditedAt",
              "provenanceComplete"
            ]
          },
          "validDomain": {
            "properties": {
              "completeKey": {
                "const": true
              },
              "exactMatchDimensions": {
                "const": [
                  "all"
                ]
              },
              "approximatedDimensions": {
                "type": "array",
                "maxItems": 0
              },
              "exclusions": {
                "type": "array",
                "maxItems": 0
              }
            },
            "required": [
              "completeKey",
              "exactMatchDimensions",
              "approximatedDimensions",
              "exclusions"
            ]
          },
          "node": {
            "properties": {
              "semantics": {
                "enum": [
                  "check_or_bet",
                  "facing_wager",
                  "preflop_unopened",
                  "preflop_facing_wager"
                ]
              },
              "potBb": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "facingBetBb": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "semantics",
              "potBb",
              "facingBetBb"
            ]
          },
          "fallbackReason": {
            "const": null
          },
          "actions": {
            "items": {
              "$ref": "#/$defs/exactAction"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "chipEv": {
            "properties": {
              "measuredByAction": {
                "const": true
              }
            },
            "required": [
              "measuredByAction"
            ]
          }
        },
        "required": [
          "chipEv"
        ]
      },
      "then": {
        "properties": {
          "actions": {
            "items": {
              "properties": {
                "chipEvBb": {
                  "type": "number"
                }
              },
              "required": [
                "chipEvBb"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "actions": {
            "items": {
              "properties": {
                "chipEvBb": {
                  "const": null
                }
              },
              "required": [
                "chipEvBb"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tournamentUtilityEv": {
            "properties": {
              "measuredByAction": {
                "const": true
              }
            },
            "required": [
              "measuredByAction"
            ]
          }
        },
        "required": [
          "tournamentUtilityEv"
        ]
      },
      "then": {
        "properties": {
          "actions": {
            "items": {
              "properties": {
                "tournamentUtilityEv": {
                  "type": "number"
                }
              },
              "required": [
                "tournamentUtilityEv"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "actions": {
            "items": {
              "properties": {
                "tournamentUtilityEv": {
                  "const": null
                }
              },
              "required": [
                "tournamentUtilityEv"
              ]
            }
          }
        }
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "exact"
            },
            "qualitySeal": {
              "enum": [
                "SOLVER_EXACT"
              ]
            }
          },
          "required": [
            "kind",
            "qualitySeal"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "aggregated"
            },
            "qualitySeal": {
              "enum": [
                "SOLVER_AGGREGATED"
              ]
            }
          },
          "required": [
            "kind",
            "qualitySeal"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "derived"
            },
            "qualitySeal": {
              "enum": [
                "SOLVER_DERIVED_RESPONSE",
                "LEGACY_UNVERIFIED"
              ]
            }
          },
          "required": [
            "kind",
            "qualitySeal"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "chart"
            },
            "qualitySeal": {
              "enum": [
                "CHART_AUDITED"
              ]
            }
          },
          "required": [
            "kind",
            "qualitySeal"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "curated"
            },
            "qualitySeal": {
              "enum": [
                "CURATED"
              ]
            }
          },
          "required": [
            "kind",
            "qualitySeal"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "heuristic"
            },
            "qualitySeal": {
              "enum": [
                "HEURISTIC"
              ]
            }
          },
          "required": [
            "kind",
            "qualitySeal"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "unavailable"
            },
            "qualitySeal": {
              "enum": [
                "UNAVAILABLE"
              ]
            }
          },
          "required": [
            "kind",
            "qualitySeal"
          ]
        }
      ]
    },
    {
      "if": {
        "not": {
          "properties": {
            "kind": {
              "const": "unavailable"
            }
          },
          "required": [
            "kind"
          ]
        }
      },
      "then": {
        "properties": {
          "actions": {
            "minItems": 1
          },
          "distribution": {
            "minProperties": 1
          }
        }
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "confidence": {
              "properties": {
                "score": {
                  "const": 0
                },
                "level": {
                  "const": "none"
                }
              },
              "required": [
                "score",
                "level"
              ]
            }
          }
        },
        {
          "properties": {
            "confidence": {
              "properties": {
                "score": {
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 0.6
                },
                "level": {
                  "const": "low"
                }
              },
              "required": [
                "score",
                "level"
              ]
            }
          }
        },
        {
          "properties": {
            "confidence": {
              "properties": {
                "score": {
                  "minimum": 0.6,
                  "exclusiveMaximum": 0.9
                },
                "level": {
                  "const": "medium"
                }
              },
              "required": [
                "score",
                "level"
              ]
            }
          }
        },
        {
          "properties": {
            "confidence": {
              "properties": {
                "score": {
                  "minimum": 0.9,
                  "maximum": 1
                },
                "level": {
                  "const": "high"
                }
              },
              "required": [
                "score",
                "level"
              ]
            }
          }
        }
      ]
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "nullableNumber": {
      "type": [
        "number",
        "null"
      ]
    },
    "nonNegativeNullableNumber": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "policyKind": {
      "enum": [
        "exact",
        "aggregated",
        "derived",
        "chart",
        "curated",
        "heuristic",
        "unavailable"
      ]
    },
    "qualitySeal": {
      "enum": [
        "SOLVER_EXACT",
        "SOLVER_AGGREGATED",
        "SOLVER_DERIVED_RESPONSE",
        "CHART_AUDITED",
        "CURATED",
        "HEURISTIC",
        "LEGACY_UNVERIFIED",
        "UNAVAILABLE"
      ]
    },
    "positions": {
      "type": "object",
      "required": [
        "hero",
        "villains",
        "button",
        "smallBlind",
        "bigBlind"
      ],
      "properties": {
        "hero": {
          "type": "string"
        },
        "villains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "button": {
          "type": "string"
        },
        "smallBlind": {
          "type": "string"
        },
        "bigBlind": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "stack": {
      "type": "object",
      "required": [
        "seat",
        "position",
        "stackChips",
        "stackBb",
        "committedChips",
        "active",
        "allIn"
      ],
      "properties": {
        "seat": {
          "type": "integer",
          "minimum": 0
        },
        "position": {
          "type": "string"
        },
        "stackChips": {
          "$ref": "#/$defs/nonNegativeNullableNumber"
        },
        "stackBb": {
          "$ref": "#/$defs/nonNegativeNullableNumber"
        },
        "committedChips": {
          "type": "number",
          "minimum": 0
        },
        "active": {
          "type": "boolean"
        },
        "allIn": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "blindState": {
      "type": "object",
      "required": [
        "smallBlind",
        "bigBlind",
        "ante",
        "bigBlindAnte",
        "straddles",
