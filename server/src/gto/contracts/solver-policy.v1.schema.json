        "action": {
          "type": "string"
        },
        "amountChips": {
          "$ref": "#/$defs/nonNegativeNullableNumber"
        },
        "amountBb": {
          "$ref": "#/$defs/nonNegativeNullableNumber"
        },
        "allIn": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
