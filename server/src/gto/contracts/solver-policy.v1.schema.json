          "type": "boolean"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/historyAction"
          }
        }
      },
      "additionalProperties": false
    },
    "legalAction": {
      "type": "object",
      "required": [
        "action",
