          "const": "smarter-poker.solver-policy.v1"
        },
        "variant": {
          "type": "string"
        },
        "bettingStructure": {
          "type": "string"
        },
        "tableSize": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2
        },
        "positions": {
          "$ref": "#/$defs/positions"
        },
        "stackVector": {
          "type": "array",
          "items": {
