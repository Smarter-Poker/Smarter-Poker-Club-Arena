# ─────────────────────────────────────────────────────────────────────────
# Sentry autofix webhook receiver — engine-01 deploy
# Copy to .env (mode 600, root-only) and fill in.
# ─────────────────────────────────────────────────────────────────────────

# ── Sentry ───────────────────────────────────────────────────────────────
# Used to HMAC-verify incoming webhook signatures. Generate with:
#   openssl rand -hex 32
# Must match the secret configured in Sentry project settings →
# Legacy Integrations → WebHooks (or Internal Integration).
SENTRY_WEBHOOK_SECRET=

# Sentry org slug (e.g. "smarter-poker"). Used to build issue URLs only.
SENTRY_ORG_SLUG=smarter-software-inc

# Allowed Sentry project slugs; comma-separated. Webhooks from any other
# project are rejected. Example:
#   club-arena-client,club-arena-engine
SENTRY_ALLOWED_PROJECTS=javascript-react,javascript-react-3h,javascript-nextjsmarter-poker-world-hubs

# ── GitHub ───────────────────────────────────────────────────────────────
# Fine-grained PAT with "repository_dispatch: write" on the target repo.
# Scope: Smarter-Poker/Smarter-Poker-Club-Arena only.
GITHUB_DISPATCH_TOKEN=

# Project-slug → target repo router (Phase 5.2.1 unified receiver).
# JSON object mapping Sentry project slug to full repo slug
# ("Owner/Name"). The receiver dispatches to exactly one repo per
# incoming webhook, chosen by the project slug on the event.
# Leave empty to fall back to legacy GITHUB_REPO (single-repo mode).
SENTRY_PROJECT_REPOS={"javascript-react":"Smarter-Poker/Smarter-Poker-Club-Arena","javascript-react-3h":"Smarter-Poker/Smarter-Poker-World-Hub","javascript-nextjsmarter-poker-world-hubs":"Smarter-Poker/Smarter-Poker-World-Hub"}

# Legacy single-repo fallback. Used only when SENTRY_PROJECT_REPOS is empty.
GITHUB_REPO=Smarter-Poker/Smarter-Poker-Club-Arena

# event_type the GH Actions workflow (.github/workflows/sentry-autofix.yml
# in each target repo) listens on.
GITHUB_DISPATCH_EVENT=sentry-autofix

# ── Supabase (dedup + rate limit) ────────────────────────────────────────
# Service-role key (NOT anon). Only used server-side. Never exposed to
# Sentry or GitHub.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Kill switch ──────────────────────────────────────────────────────────
# Set to "false" to drop all webhooks (respond 202) without dispatching.
AUTOFIX_ENABLED=true

# Max autofix PRs to open per rolling window, org-wide.
AUTOFIX_RATE_LIMIT_HOURLY=3
AUTOFIX_RATE_LIMIT_DAILY=10

# ── Observability ────────────────────────────────────────────────────────
LOG_LEVEL=info
PORT=8787
