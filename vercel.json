{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/",
      "destination": "/hub/club-arena/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/hub/club-arena/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/hub/club-arena/images/:path*",
      "destination": "/images/:path*"
    },
    {
      "source": "/hub/club-arena/videos/:path*",
      "destination": "/videos/:path*"
    },
    {
      "source": "/club-stats-panel.svg",
      "destination": "/club-stats-panel.svg"
    },
    {
      "source": "/hub/club-arena/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/hub/club-arena",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/|images/|videos/|.*\\.svg$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://smarter.poker https://*.smarter.poker https://club-arena.vercel.app https://*.vercel.app http://localhost:3000"
        }
      ]
    }
  ]
}
